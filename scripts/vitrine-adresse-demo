#!/usr/bin/env bash
# vitrine-adresse-demo — règle l'adresse de la démo affichée sur la vitrine.
#   vitrine-adresse-demo https://demo.mon-site.fr
#   (sans adresse : les boutons « Essayer la démo » restent sur la page)
set -euo pipefail
URL="${1:-}"
case "$URL" in
  ""|http://*|https://*) ;;
  *) echo "L'adresse doit commencer par https:// (ex. https://demo.mon-site.fr)" >&2; exit 1 ;;
esac
case "$URL" in *'"'*|*'\'*|*'<'*) echo "Adresse invalide." >&2; exit 1 ;; esac
mkdir -p /etc/recipelog-vitrine
cat > /etc/recipelog-vitrine/config.js <<JS
// Réglages de ce serveur (écrit par vitrine-adresse-demo, gardé aux mises à jour).
window.VITRINE = { demoUrl: "${URL}" };
JS
echo "Adresse de la démo : ${URL:-(aucune)}"
