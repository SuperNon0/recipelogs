#!/usr/bin/env bash
# ============================================================
# recipelog-instance : gérer les clients de la plateforme RecipeLog.
# Un client = une base dans le PostgreSQL partagé + un conteneur RecipeLog
# sur <nom>.<domaine>. Le panel admin (lot 2) fera la même chose en 1 clic.
#
#   recipelog-instance creer <nom> [--canal beta|stable|plateforme] [--responsable email]
#                                  [--max N] [--essai jours] [--sans-mcp] [--admin email]
#                                  [--demo] [--sans-authentik]
#   recipelog-instance liste [--json]
#   recipelog-instance suspendre <nom> | reactiver <nom>
#   recipelog-instance options <nom> --mcp oui|non
#   recipelog-instance essai <nom> <jours|0>     (0 = plus d'essai : client normal)
#   recipelog-instance verifier-essais           (met en pause les essais terminés)
#   recipelog-instance equipe <nom>
#   recipelog-instance inviter <nom> <email> [nom affiché]
#   recipelog-instance quota <nom> <N|0>          (0 = pas de plafond)
#   recipelog-instance brancher-authentik <nom> [--responsable email] [--max N]
#   recipelog-instance mettre-a-jour <nom>|--tous
#   recipelog-instance redemarrer <nom>
#   recipelog-instance journaux <nom>
#   recipelog-instance supprimer <nom> --oui
#   recipelog-instance sauvegarder <nom>|--tous [--etiquette mot]
#   recipelog-instance sauvegardes <nom> [--json]
#   recipelog-instance restaurer <nom> <sauvegarde> --oui
#   recipelog-instance tester-sauvegarde <nom>|--tous
#   recipelog-instance exporter <nom> <sauvegarde> > fichier.tar.gz   (sans mots de passe)
#
# Réglages lus dans /srv/recipelog/.env (écrit par install.sh).
# Chaque client a son dossier /srv/recipelog/instances/<nom>/ :
#   instance.conf  canal, date de création, connexion (authentik ou cloudflare),
#                  pause (SUSPENDU=1), fin d'essai (ESSAI_FIN), MCP (oui/non)
#   instance.env   variables du conteneur (mot de passe de sa base, réglages
#                  de connexion Authentik : voir ../connexion.md)
#   uploads/       photos et factures envoyées
# Sauvegardes de chaque client dans /srv/recipelog/sauvegardes/<nom>/.
# ============================================================
set -euo pipefail

DONNEES="${DONNEES:-/srv/recipelog}"
ENV_FILE="${DONNEES}/.env"
[ -r "${ENV_FILE}" ] || { echo "❌ ${ENV_FILE} introuvable : lancer d'abord install.sh." >&2; exit 1; }
set -a
# shellcheck source=/dev/null
. "${ENV_FILE}"
set +a

DOMAINE="${DOMAINE:-recipelog.cc}"
IMAGE="${IMAGE:-ghcr.io/supernon0/recipelog}"
INSTANCES="${DONNEES}/instances"
ARCHIVES="${DONNEES}/archives"
SAUVEGARDES="${DONNEES}/sauvegardes"
GARDER_JOURS="${SAUVEGARDE_JOURS:-7}"
GARDER_SEMAINES="${SAUVEGARDE_SEMAINES:-4}"
GARDER_MOIS="${SAUVEGARDE_MOIS:-6}"
PG="recipelog-postgres"
RESERVES=" www admin auth demo api status mail smtp traefik panel plateforme "
MEMOIRE="${INSTANCE_MEMOIRE:-1g}"

die() { echo "❌ $*" >&2; exit 1; }
info() { echo "==> $*"; }

nom_valide() {
  local n="$1"
  [[ "${n}" =~ ^[a-z0-9][a-z0-9-]{0,30}[a-z0-9]$ ]] || die "Nom « ${n} » refusé : 2 à 32 caractères, minuscules, chiffres et tirets (pas au début ni à la fin)."
  [[ "${RESERVES}" != *" ${n} "* ]] || die "« ${n} » est réservé à la plateforme."
}
conteneur() { echo "rl-$1"; }
# aleatoire <octets> : secret en hexadécimal (sans dépendre d'openssl).
aleatoire() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }
# Télécharge l'image ; sans réseau, garde celle déjà présente sur la machine.
tirer() {
  docker pull -q "$1" >/dev/null 2>&1 && return 0
  docker image inspect "$1" >/dev/null 2>&1 || die "Impossible de télécharger $1."
  echo "⚠️  Téléchargement de $1 impossible : la version déjà présente est utilisée." >&2
}
base() { echo "rl_${1//-/_}"; }
existe() { [ -d "${INSTANCES}/$1" ]; }

# Commande d'administration de la passerelle (seule à parler à Authentik).
passerelle() { docker exec recipelog-passerelle node cli.mjs "$@"; }
passerelle_ok() { docker inspect -f '{{.State.Running}}' recipelog-passerelle 2>/dev/null | grep -q true; }

# Crée le client dans Authentik et ajoute ses réglages de connexion à instance.env.
# brancher <nom> <max> <responsable>
brancher() {
  local nom="$1" max="$2" resp="$3" dir="${INSTANCES}/$1" reglages
  passerelle_ok || die "La passerelle ne tourne pas (recipelog-plateforme ps). Sans Authentik : --sans-authentik."
  info "Client « ${nom} » dans Authentik…"
  reglages="$(passerelle client-creer "${nom}" "${max}" "https://${nom}.${DOMAINE}" --env)" || die "Authentik a refusé la création du client « ${nom} »."
  sed -i '/^RECIPELOG_AUTH_MODE=/d;/^RECIPELOG_URL=/d;/^OIDC_/d;/^RECIPELOG_SESSION_SECRET=/d;/^RECIPELOG_PASSERELLE_/d;/^RECIPELOG_RESPONSABLE_EMAIL=/d' "${dir}/instance.env"
  umask 077
  {
    echo "RECIPELOG_AUTH_MODE=oidc"
    echo "RECIPELOG_URL=https://${nom}.${DOMAINE}"
    echo "${reglages}"
    echo "RECIPELOG_SESSION_SECRET=$(aleatoire 32)"
    echo "RECIPELOG_PASSERELLE_URL=http://recipelog-passerelle:8000"
    [ -n "${resp}" ] && echo "RECIPELOG_RESPONSABLE_EMAIL=${resp}"
  } >> "${dir}/instance.env"
  umask 022
  sed -i '/^CONNEXION=/d' "${dir}/instance.conf"
  echo "CONNEXION=authentik" >> "${dir}/instance.conf"
}

# Invite le responsable (email « Choisis ton mot de passe »).
inviter_responsable() {
  local nom="$1" resp="$2"
  [ -n "${resp}" ] || return 0
  if passerelle inviter "${nom}" "${resp}" >/dev/null; then
    info "Invitation envoyée à ${resp}."
  else
    echo "⚠️  Invitation de ${resp} impossible. À relancer : recipelog-instance inviter ${nom} ${resp}" >&2
  fi
}

# Lit / écrit une ligne CLE=valeur de instance.conf.
conf_lire() { sed -n "s/^$2=//p" "${INSTANCES}/$1/instance.conf" 2>/dev/null | tail -1; }
conf_ecrire() { # conf_ecrire <nom> <CLE> [valeur]  (sans valeur : retire la ligne)
  local f="${INSTANCES}/$1/instance.conf"
  sed -i "/^$2=/d" "${f}"
  [ $# -lt 3 ] || echo "$2=$3" >> "${f}"
}
suspendu() { [ "$(conf_lire "$1" SUSPENDU)" = 1 ]; }

verifier_email() { [[ "$1" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || die "Adresse email invalide : $1"; }
verifier_max() { [[ "$1" =~ ^[0-9]+$ ]] || die "Nombre de comptes invalide : $1 (0 = pas de plafond)."; }

psql_admin() { docker exec -i "${PG}" psql -v ON_ERROR_STOP=1 -q -U postgres "$@"; }

# Lance (ou relance) le conteneur d'un client à partir de son dossier.
# $2 facultatif : image exacte à utiliser (retour en arrière).
lancer() {
  local nom="$1" image_forcee="${2:-}" dir="${INSTANCES}/$1" c
  c="$(conteneur "${nom}")"
  # shellcheck disable=SC1091
  . "${dir}/instance.conf"
  local image="${image_forcee:-${IMAGE}:${CANAL}}"
  docker rm -f "${c}" >/dev/null 2>&1 || true
  docker run -d --name "${c}" \
    --network recipelog \
    --restart unless-stopped \
    --memory "${MEMOIRE}" \
    --shm-size 256m \
    --env-file "${dir}/instance.env" \
    -v "${dir}/uploads:/data/uploads" \
    --label "recipelog.instance=${nom}" \
    --label "recipelog.canal=${CANAL}" \
    --label "traefik.enable=true" \
    --label "traefik.http.routers.${c}.rule=Host(\`${nom}.${DOMAINE}\`)" \
    --label "traefik.http.routers.${c}.entrypoints=web" \
    --label "traefik.http.routers.${c}.middlewares=securite@file,limite@file" \
    --label "traefik.http.services.${c}.loadbalancer.server.port=3000" \
    "${image}" >/dev/null
}

# Attend que le conteneur réponde (migrations + démarrage). 0 = prêt.
attendre() {
  local c; c="$(conteneur "$1")"
  local etat
  for _ in $(seq 1 60); do
    etat="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "${c}" 2>/dev/null || echo absent)"
    case "${etat}" in
      healthy) return 0 ;;
      exited|dead|absent) return 1 ;;
    esac
    sleep 3
  done
  return 1
}

cmd_creer() {
  local nom="" canal="${CANAL_DEFAUT:-stable}" admin="${ADMIN_EMAILS:-}" demo=0 resp="" max=0 authentik=1 essai=0 mcp=oui
  while [ $# -gt 0 ]; do
    case "$1" in
      --canal) canal="${2:-}"; shift 2 ;;
      --admin) admin="${2:-}"; shift 2 ;;
      --responsable) resp="${2:-}"; shift 2 ;;
      --max) max="${2:-}"; shift 2 ;;
      --sans-authentik) authentik=0; shift ;;
      --essai) essai="${2:-}"; shift 2 ;;
      --sans-mcp) mcp=non; shift ;;
      --demo) demo=1; shift ;;
      -*) die "Option inconnue : $1" ;;
      *) [ -z "${nom}" ] || die "Un seul nom à la fois."; nom="$1"; shift ;;
    esac
  done
  [ -n "${nom}" ] || die "Usage : recipelog-instance creer <nom> [--canal …] [--responsable email] [--max N] [--admin email] [--demo] [--sans-authentik]"
  nom_valide "${nom}"
  [ -z "${resp}" ] || verifier_email "${resp}"
  verifier_max "${max}"
  [[ "${essai}" =~ ^[0-9]+$ ]] || die "Durée d'essai invalide : ${essai} (en jours)."
  [ "${authentik}" = 0 ] || passerelle_ok || die "La passerelle ne tourne pas (recipelog-plateforme ps). Sans Authentik : --sans-authentik."
  [[ "${canal}" =~ ^(beta|stable|plateforme)$ ]] || die "Canal « ${canal} » inconnu (beta, stable ou plateforme)."
  existe "${nom}" && die "Le client « ${nom} » existe déjà."

  local dir="${INSTANCES}/${nom}" db mdp
  db="$(base "${nom}")"
  mdp="$(aleatoire 24)"

  info "Base ${db} dans PostgreSQL…"
  psql_admin <<SQL
CREATE ROLE ${db} LOGIN PASSWORD '${mdp}';
CREATE DATABASE ${db} OWNER ${db};
REVOKE ALL ON DATABASE ${db} FROM PUBLIC;
SQL
  psql_admin -d "${db}" -c "CREATE EXTENSION IF NOT EXISTS pg_trgm;"

  info "Dossier ${dir}…"
  mkdir -p "${dir}/uploads"
  chown 1000:1000 "${dir}/uploads" # utilisateur « node » de l'image
  umask 077
  cat > "${dir}/instance.conf" <<CONF
CANAL=${canal}
CREE_LE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
CONNEXION=cloudflare
MCP=${mcp}
$([ "${essai}" -gt 0 ] && echo "ESSAI_FIN=$(date -u -d "+${essai} days" +%Y-%m-%d)")
CONF
  {
    echo "DATABASE_URL=postgresql://${db}:${mdp}@${PG}:5432/${db}"
    echo "RECIPELOG_INSTANCE=${nom}"
    echo "RECIPELOG_ADMIN_EMAILS=${admin}"
    [ "${demo}" = 1 ] && echo "RECIPELOG_DEMO=1"
    [ "${mcp}" = non ] && echo "RECIPELOG_MCP=0"
  } > "${dir}/instance.env"
  umask 022
  [ "${authentik}" = 1 ] && brancher "${nom}" "${max}" "${resp}"

  info "Téléchargement de ${IMAGE}:${canal}…"
  tirer "${IMAGE}:${canal}"
  info "Démarrage de $(conteneur "${nom}")…"
  lancer "${nom}"
  if attendre "${nom}"; then
    info "✅ ${nom} est prêt : https://${nom}.${DOMAINE}"
    if [ "${authentik}" = 1 ]; then
      inviter_responsable "${nom}" "${resp}"
    else
      echo "   Sans Authentik : protège cette adresse dans Cloudflare Access."
    fi
  else
    docker logs --tail 40 "$(conteneur "${nom}")" >&2 || true
    die "${nom} ne démarre pas (journaux ci-dessus). Le dossier et la base sont gardés : recipelog-instance redemarrer ${nom}"
  fi
}

# Passe un client existant (créé sans Authentik) sur la connexion par Authentik.
cmd_brancher() {
  local nom="" resp="" max=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --responsable) resp="${2:-}"; shift 2 ;;
      --max) max="${2:-}"; shift 2 ;;
      -*) die "Option inconnue : $1" ;;
      *) nom="$1"; shift ;;
    esac
  done
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance brancher-authentik <nom existant> [--responsable email] [--max N]"
  [ -z "${resp}" ] || verifier_email "${resp}"
  verifier_max "${max}"
  grep -q '^CONNEXION=authentik' "${INSTANCES}/${nom}/instance.conf" && die "« ${nom} » utilise déjà Authentik."
  brancher "${nom}" "${max}" "${resp}"
  lancer "${nom}"
  attendre "${nom}" || die "${nom} ne redémarre pas : recipelog-instance journaux ${nom}"
  inviter_responsable "${nom}" "${resp}"
  info "✅ ${nom} se connecte maintenant par Authentik. Tu peux retirer sa protection Cloudflare Access."
}

cmd_equipe() {
  [ $# -eq 1 ] && existe "$1" || die "Usage : recipelog-instance equipe <nom existant>"
  passerelle equipe "$1"
}

cmd_inviter() {
  [ $# -ge 2 ] && existe "$1" || die "Usage : recipelog-instance inviter <nom existant> <email> [nom affiché]"
  verifier_email "$2"
  passerelle inviter "$@"
}

cmd_quota() {
  [ $# -eq 2 ] && existe "$1" || die "Usage : recipelog-instance quota <nom existant> <N|0>   (0 = pas de plafond)"
  verifier_max "$2"
  passerelle quota "$1" "$2" >/dev/null && info "✅ $1 : $([ "$2" = 0 ] && echo "pas de plafond" || echo "$2 comptes au plus")."
}

etat_conteneur() {
  docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$(conteneur "$1")" 2>/dev/null || echo arrêté
}

cmd_liste() {
  local json=0 d nom etat canal cx premier=1
  [ "${1:-}" = "--json" ] && json=1
  if [ "${json}" = 1 ]; then
    printf '['
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      nom="$(basename "${d}")"
      [ "${premier}" = 1 ] || printf ','
      premier=0
      # Valeurs contrôlées (noms, dates, mots-clés) : pas de guillemets à échapper.
      printf '{"nom":"%s","canal":"%s","connexion":"%s","etat":"%s","adresse":"https://%s.%s","creeLe":"%s","suspendu":%s,"essaiFin":"%s","mcp":%s}' \
        "${nom}" "$(conf_lire "${nom}" CANAL)" "$(conf_lire "${nom}" CONNEXION)" "$(etat_conteneur "${nom}")" \
        "${nom}" "${DOMAINE}" "$(conf_lire "${nom}" CREE_LE)" \
        "$(suspendu "${nom}" && echo true || echo false)" "$(conf_lire "${nom}" ESSAI_FIN)" \
        "$([ "$(conf_lire "${nom}" MCP)" = non ] && echo false || echo true)"
    done
    printf ']\n'
    return
  fi
  printf "%-20s %-10s %-10s %-10s %s\n" "CLIENT" "CANAL" "CONNEXION" "ÉTAT" "ADRESSE"
  for d in "${INSTANCES}"/*/; do
    [ -d "${d}" ] || continue
    nom="$(basename "${d}")"
    canal="$(conf_lire "${nom}" CANAL)"
    cx="$(conf_lire "${nom}" CONNEXION)"
    etat="$(etat_conteneur "${nom}")"
    suspendu "${nom}" && etat="en pause"
    printf "%-20s %-10s %-10s %-10s %s\n" "${nom}" "${canal}" "${cx:-cloudflare}" "${etat}" "https://${nom}.${DOMAINE}"
  done
}

cmd_suspendre() {
  [ $# -eq 1 ] && existe "$1" || die "Usage : recipelog-instance suspendre <nom existant>"
  suspendu "$1" && { info "$1 est déjà en pause."; return 0; }
  docker stop "$(conteneur "$1")" >/dev/null 2>&1 || true
  conf_ecrire "$1" SUSPENDU 1
  info "⏸️  $1 est en pause : son adresse affiche « site en pause ». Les données sont gardées."
}

cmd_reactiver() {
  [ $# -eq 1 ] && existe "$1" || die "Usage : recipelog-instance reactiver <nom existant>"
  conf_ecrire "$1" SUSPENDU
  tirer "${IMAGE}:$(conf_lire "$1" CANAL)"
  lancer "$1"
  attendre "$1" && info "✅ $1 est de nouveau en ligne." || die "$1 ne démarre pas : recipelog-instance journaux $1"
}

cmd_options() {
  local nom="${1:-}" mcp=""
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --mcp) mcp="${2:-}"; shift 2 ;;
      *) die "Option inconnue : $1" ;;
    esac
  done
  [ -n "${nom}" ] && existe "${nom}" && [[ "${mcp}" =~ ^(oui|non)$ ]] || die "Usage : recipelog-instance options <nom existant> --mcp oui|non"
  local f="${INSTANCES}/${nom}/instance.env"
  sed -i '/^RECIPELOG_MCP=/d' "${f}"
  [ "${mcp}" = non ] && echo "RECIPELOG_MCP=0" >> "${f}"
  conf_ecrire "${nom}" MCP "${mcp}"
  if ! suspendu "${nom}"; then
    lancer "${nom}"
    attendre "${nom}" || die "${nom} ne redémarre pas : recipelog-instance journaux ${nom}"
  fi
  info "✅ ${nom} : accès MCP $([ "${mcp}" = oui ] && echo permis || echo coupé)."
}

cmd_essai() {
  [ $# -eq 2 ] && existe "$1" && [[ "$2" =~ ^[0-9]+$ ]] || die "Usage : recipelog-instance essai <nom existant> <jours|0>"
  if [ "$2" = 0 ]; then
    conf_ecrire "$1" ESSAI_FIN
    info "✅ $1 n'est plus en essai."
  else
    conf_ecrire "$1" ESSAI_FIN "$(date -u -d "+$2 days" +%Y-%m-%d)"
    info "✅ $1 : essai jusqu'au $(conf_lire "$1" ESSAI_FIN) inclus."
  fi
}

# Met en pause les clients dont l'essai est fini (lancé toutes les heures par le moteur).
cmd_verifier_essais() {
  local d nom fin aujourdhui
  aujourdhui="$(date -u +%Y-%m-%d)"
  for d in "${INSTANCES}"/*/; do
    [ -d "${d}" ] || continue
    nom="$(basename "${d}")"
    fin="$(conf_lire "${nom}" ESSAI_FIN)"
    [ -n "${fin}" ] || continue
    suspendu "${nom}" && continue
    if [[ "${fin}" < "${aujourdhui}" ]]; then
      info "Essai de ${nom} terminé le ${fin} : mise en pause."
      cmd_suspendre "${nom}"
    fi
  done
}

# Met à jour un client : nouvelle image, puis retour à l'ancienne s'il ne
# redémarre pas. Avec --tous : un client après l'autre, arrêt au premier échec.
maj_un() {
  local nom="$1" c ancienne canal
  existe "${nom}" || die "Client « ${nom} » inconnu."
  if suspendu "${nom}"; then
    info "${nom} est en pause : il prendra la dernière version à sa réactivation."
    return 0
  fi
  c="$(conteneur "${nom}")"
  canal="$(sed -n 's/^CANAL=//p' "${INSTANCES}/${nom}/instance.conf")"
  ancienne="$(docker inspect -f '{{.Image}}' "${c}" 2>/dev/null || true)"
  info "${nom} : téléchargement de ${IMAGE}:${canal}…"
  tirer "${IMAGE}:${canal}"
  if [ -n "${ancienne}" ] && [ "$(docker image inspect -f '{{.Id}}' "${IMAGE}:${canal}")" = "${ancienne}" ]; then
    info "${nom} : déjà à jour."
    return 0
  fi
  lancer "${nom}"
  if attendre "${nom}"; then
    info "✅ ${nom} : mis à jour."
    return 0
  fi
  echo "⚠️  ${nom} ne redémarre pas avec la nouvelle version :" >&2
  docker logs --tail 30 "${c}" >&2 || true
  if [ -n "${ancienne}" ]; then
    info "${nom} : retour à la version précédente…"
    lancer "${nom}" "${ancienne}"
    attendre "${nom}" && info "${nom} : version précédente remise." || echo "❌ ${nom} : la version précédente ne redémarre pas non plus." >&2
  fi
  return 1
}

cmd_maj() {
  [ $# -eq 1 ] || die "Usage : recipelog-instance mettre-a-jour <nom>|--tous"
  if [ "$1" = "--tous" ]; then
    local d
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      maj_un "$(basename "${d}")" || die "Arrêt : les clients suivants n'ont pas été mis à jour."
    done
  else
    maj_un "$1"
  fi
}

cmd_redemarrer() {
  [ $# -eq 1 ] && existe "$1" || die "Usage : recipelog-instance redemarrer <nom existant>"
  suspendu "$1" && die "$1 est en pause : recipelog-instance reactiver $1"
  lancer "$1"
  attendre "$1" && info "✅ $1 a redémarré." || die "$1 ne démarre pas : recipelog-instance journaux $1"
}

cmd_journaux() {
  [ $# -eq 1 ] || die "Usage : recipelog-instance journaux <nom>"
  docker logs -f --tail 100 "$(conteneur "$1")"
}

# ------------------------------------------------------------ sauvegardes (lot 3)
# Une sauvegarde = un dossier sauvegardes/<nom>/<AAAAMMJJ-HHMMSS>/ :
#   base.dump        la base du client (pg_dump, format compressé)
#   fichiers.tar.gz  photos et factures (uploads/) + instance.conf
#   reglages.tar.gz  instance.env (mots de passe : jamais dans un export)
#   infos.json       date, étiquette, version, tailles
# Rotation : TOUTES celles des GARDER_JOURS derniers jours ; avant, la plus récente
# de chaque semaine (GARDER_SEMAINES semaines) et de chaque mois (GARDER_MOIS mois).
dossier_sauv() { echo "${SAUVEGARDES}/$1"; }
id_valide() { [[ "$1" =~ ^[0-9]{8}-[0-9]{6}$ ]] || die "Sauvegarde « $1 » inconnue."; }

version_client() {
  docker exec "$(conteneur "$1")" node -e 'fetch("http://127.0.0.1:3000/api/health").then(r=>r.json()).then(j=>console.log(j.version||"")).catch(()=>{})' 2>/dev/null || true
}

# sauvegarder_un <nom> [etiquette] [--sans-rotation] : affiche l'identifiant de la sauvegarde.
sauvegarder_un() {
  local nom="$1" etiquette="${2:-auto}" rotation="${3:-}" dir="${INSTANCES}/$1" racine id tmp db version
  racine="$(dossier_sauv "${nom}")"
  db="$(base "${nom}")"
  mkdir -p "${racine}"; chmod 700 "${SAUVEGARDES}" "${racine}"
  # Restes d'une sauvegarde interrompue.
  find "${racine}" -mindepth 1 -maxdepth 1 -type d -name '*.partiel' -exec rm -rf {} +
  id="$(date -u +%Y%m%d-%H%M%S)"
  while [ -e "${racine}/${id}" ]; do sleep 1; id="$(date -u +%Y%m%d-%H%M%S)"; done
  tmp="${racine}/${id}.partiel"
  mkdir -m 700 "${tmp}"
  docker exec "${PG}" pg_dump -U postgres -Fc "${db}" > "${tmp}/base.dump" || { echo "❌ ${nom} : la base n'a pas pu être sauvegardée." >&2; return 1; }
  tar -C "${dir}" -czf "${tmp}/fichiers.tar.gz" uploads instance.conf || { echo "❌ ${nom} : les fichiers n'ont pas pu être sauvegardés." >&2; return 1; }
  tar -C "${dir}" -czf "${tmp}/reglages.tar.gz" instance.env
  version="$(version_client "${nom}")"
  printf '{"id":"%s","date":"%s","etiquette":"%s","version":"%s","base":%s,"fichiers":%s}\n' \
    "${id}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${etiquette}" "${version}" \
    "$(stat -c %s "${tmp}/base.dump")" "$(stat -c %s "${tmp}/fichiers.tar.gz")" > "${tmp}/infos.json"
  chmod 600 "${tmp}"/*
  mv "${tmp}" "${racine}/${id}"
  [ "${rotation}" = "--sans-rotation" ] || elaguer "${nom}"
  echo "${id}"
}

# Garde la plus récente de chaque jour / semaine / mois dans les limites ; supprime le reste.
elaguer() {
  local racine id jour sem mois limite
  racine="$(dossier_sauv "$1")"
  limite="$(date -u -d "-$((GARDER_JOURS - 1)) days" +%Y%m%d)"
  declare -A semaines=() moisv=() garder=()
  local ids=()
  mapfile -t ids < <(find "${racine}" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}' -printf '%f\n' | sort -r)
  for id in "${ids[@]}"; do
    jour="${id:0:8}"
    sem="$(date -u -d "${jour}" +%G%V)"
    mois="${id:0:6}"
    if [[ ! "${jour}" < "${limite}" ]]; then garder[${id}]=1; continue; fi
    if [ -z "${semaines[${sem}]:-}" ] && [ "${#semaines[@]}" -lt "${GARDER_SEMAINES}" ]; then semaines[${sem}]=1; garder[${id}]=1; fi
    if [ -z "${moisv[${mois}]:-}" ] && [ "${#moisv[@]}" -lt "${GARDER_MOIS}" ]; then moisv[${mois}]=1; garder[${id}]=1; fi
  done
  for id in "${ids[@]}"; do
    [ -n "${garder[${id}]:-}" ] || find "${racine}" -mindepth 1 -maxdepth 1 -type d -name "${id}" -exec rm -rf {} +
  done
}

cmd_sauvegarder() {
  local cible="${1:-}" etiquette="manuelle"
  [ -n "${cible}" ] || die "Usage : recipelog-instance sauvegarder <nom>|--tous [--etiquette mot]"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --etiquette) [[ "${2:-}" =~ ^[a-z0-9-]{1,30}$ ]] || die "Étiquette invalide."; etiquette="$2"; shift 2 ;;
      *) die "Option inconnue : $1" ;;
    esac
  done
  if [ "${cible}" = "--tous" ]; then
    local d n echecs=0
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      n="$(basename "${d}")"
      if id="$(sauvegarder_un "${n}" "${etiquette}")"; then info "${n} : sauvegarde ${id}"; else echecs=$((echecs + 1)); fi
    done
    [ "${echecs}" -eq 0 ] || die "${echecs} client(s) non sauvegardé(s)."
  else
    existe "${cible}" || die "Client « ${cible} » inconnu."
    local id; id="$(sauvegarder_un "${cible}" "${etiquette}")" || die "Sauvegarde de ${cible} ratée."
    info "✅ ${cible} : sauvegarde ${id}"
  fi
}

cmd_sauvegardes() {
  local nom="${1:-}" json="${2:-}" racine id
  [ -n "${nom}" ] || die "Usage : recipelog-instance sauvegardes <nom> [--json]"
  racine="$(dossier_sauv "${nom}")"
  local ids=()
  [ -d "${racine}" ] && mapfile -t ids < <(find "${racine}" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}' -printf '%f\n' | sort -r)
  if [ "${json}" = "--json" ]; then
    local sep="" test="null"
    printf '{"sauvegardes":['
    for id in "${ids[@]}"; do
      [ -r "${racine}/${id}/infos.json" ] || continue
      printf '%s%s' "${sep}" "$(tr -d '\n' < "${racine}/${id}/infos.json")"; sep=","
    done
    [ -r "${racine}/dernier-test.json" ] && test="$(tr -d '\n' < "${racine}/dernier-test.json")"
    printf '],"test":%s}\n' "${test}"
  else
    [ "${#ids[@]}" -gt 0 ] || { echo "Aucune sauvegarde pour ${nom}."; return 0; }
    printf '%-17s %-20s %10s %10s\n' SAUVEGARDE ETIQUETTE BASE FICHIERS
    for id in "${ids[@]}"; do
      local f="${racine}/${id}/infos.json"
      printf '%-17s %-20s %10s %10s\n' "${id}" \
        "$(sed -n 's/.*"etiquette":"\([^"]*\)".*/\1/p' "${f}")" \
        "$(numfmt --to=iec "$(sed -n 's/.*"base":\([0-9]*\).*/\1/p' "${f}")")" \
        "$(numfmt --to=iec "$(sed -n 's/.*"fichiers":\([0-9]*\).*/\1/p' "${f}")")"
    done
    [ -r "${racine}/dernier-test.json" ] && echo "Dernier test de restauration : $(cat "${racine}/dernier-test.json")"
  fi
}

# charger_base <base> <rôle> <fichier dump> : recrée la base à partir d'une sauvegarde.
charger_base() {
  local db="$1" role="$2" dump="$3"
  psql_admin >/dev/null <<SQL
SET client_min_messages TO warning;
SELECT pg_terminate_backend(pid) FROM pg_stat_activity WHERE datname = '${db}' AND pid <> pg_backend_pid();
DROP DATABASE IF EXISTS ${db};
CREATE DATABASE ${db} OWNER ${role};
REVOKE ALL ON DATABASE ${db} FROM PUBLIC;
SQL
  docker exec -i "${PG}" pg_restore -U postgres -d "${db}" --no-owner --role="${role}" --exit-on-error < "${dump}"
}

cmd_restaurer() {
  local nom="${1:-}" id="${2:-}" ok="${3:-}" dir sauv db secu
  [ -n "${nom}" ] && [ -n "${id}" ] || die "Usage : recipelog-instance restaurer <nom> <sauvegarde> --oui"
  existe "${nom}" || die "Client « ${nom} » inconnu."
  id_valide "${id}"
  sauv="$(dossier_sauv "${nom}")/${id}"
  [ -r "${sauv}/base.dump" ] || die "Sauvegarde « ${id} » introuvable pour ${nom}."
  [ "${ok}" = "--oui" ] || die "Ajoute --oui : les données actuelles de ${nom} seront remplacées."
  dir="${INSTANCES}/${nom}"; db="$(base "${nom}")"
  info "Sauvegarde de sécurité de l'état actuel…"
  secu="$(sauvegarder_un "${nom}" avant-restauration --sans-rotation)" || die "Sauvegarde de sécurité ratée : rien n'a été changé."
  info "Arrêt de ${nom}…"
  docker rm -f "$(conteneur "${nom}")" >/dev/null 2>&1 || true
  info "Remise de la base (${id})…"
  if ! charger_base "${db}" "${db}" "${sauv}/base.dump"; then
    echo "❌ La base n'a pas pu être remise. Retour à l'état d'avant (${secu})…" >&2
    charger_base "${db}" "${db}" "$(dossier_sauv "${nom}")/${secu}/base.dump" || true
    suspendu "${nom}" || lancer "${nom}"
    die "Restauration annulée."
  fi
  info "Remise des photos et factures…"
  local neuf="${dir}/uploads.neuf"
  find "${dir}" -mindepth 1 -maxdepth 1 -name 'uploads.neuf' -exec rm -rf {} +
  mkdir -p "${neuf}"
  tar -C "${neuf}" -xzf "${sauv}/fichiers.tar.gz" uploads
  find "${dir}" -mindepth 1 -maxdepth 1 -name 'uploads.avant' -exec rm -rf {} +
  mv "${dir}/uploads" "${dir}/uploads.avant"
  mv "${neuf}/uploads" "${dir}/uploads"
  find "${dir}" -mindepth 1 -maxdepth 1 \( -name 'uploads.neuf' -o -name 'uploads.avant' \) -exec rm -rf {} +
  chown -R 1000:1000 "${dir}/uploads"
  if suspendu "${nom}"; then
    info "✅ ${nom} restauré (${id}). Il reste en pause."
  else
    lancer "${nom}"
    attendre "${nom}" || die "${nom} ne redémarre pas : recipelog-instance journaux ${nom} (état d'avant : ${secu})"
    info "✅ ${nom} restauré (${id}). État d'avant gardé : ${secu}"
  fi
}

# Restaure la dernière sauvegarde dans une base temporaire pour vérifier qu'elle est bonne.
tester_un() {
  local nom="$1" racine id essai recettes ok=true raison=""
  racine="$(dossier_sauv "${nom}")"
  id="$(find "${racine}" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}' -printf '%f\n' 2>/dev/null | sort -r | head -1)"
  [ -n "${id}" ] || { echo "⚠️  ${nom} : aucune sauvegarde à tester." >&2; return 1; }
  essai="rl_essai_${nom//-/_}"
  psql_admin -c "SET client_min_messages TO warning;" -c "DROP DATABASE IF EXISTS ${essai};" -c "CREATE DATABASE ${essai};" >/dev/null
  if ! docker exec -i "${PG}" pg_restore -U postgres -d "${essai}" --no-owner --exit-on-error < "${racine}/${id}/base.dump" >/dev/null 2>&1; then
    ok=false; raison="la base ne se recharge pas"
  else
    recettes="$(docker exec "${PG}" psql -U postgres -d "${essai}" -tAc 'SELECT count(*) FROM recipes' 2>/dev/null)" || { ok=false; raison="table des recettes absente"; }
  fi
  if ${ok} && ! tar -tzf "${racine}/${id}/fichiers.tar.gz" >/dev/null 2>&1; then ok=false; raison="archive des fichiers abîmée"; fi
  psql_admin -c "SET client_min_messages TO warning;" -c "DROP DATABASE IF EXISTS ${essai};" >/dev/null || true
  printf '{"date":"%s","sauvegarde":"%s","ok":%s,"recettes":%s,"raison":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${id}" "${ok}" "${recettes:-0}" "${raison}" > "${racine}/dernier-test.json"
  if ${ok}; then info "${nom} : sauvegarde ${id} relue sans erreur (${recettes} recettes)."; else echo "❌ ${nom} : sauvegarde ${id} : ${raison}." >&2; return 1; fi
}

cmd_tester_sauvegarde() {
  [ $# -eq 1 ] || die "Usage : recipelog-instance tester-sauvegarde <nom>|--tous"
  if [ "$1" = "--tous" ]; then
    local d echecs=0
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      tester_un "$(basename "${d}")" || echecs=$((echecs + 1))
    done
    [ "${echecs}" -eq 0 ] || die "${echecs} sauvegarde(s) en échec."
  else
    existe "$1" || die "Client « $1 » inconnu."
    tester_un "$1" || exit 1
  fi
}

# Archive .tar.gz sur la sortie standard : base + fichiers, sans les mots de passe.
cmd_exporter() {
  local nom="${1:-}" id="${2:-}" sauv
  [ -n "${nom}" ] && [ -n "${id}" ] || die "Usage : recipelog-instance exporter <nom> <sauvegarde> > fichier.tar.gz"
  id_valide "${id}"
  sauv="$(dossier_sauv "${nom}")/${id}"
  [ -r "${sauv}/base.dump" ] || die "Sauvegarde « ${id} » introuvable pour ${nom}."
  [ -t 1 ] && die "Rediriger la sortie vers un fichier : … > ${nom}-${id}.tar.gz"
  tar -C "${sauv}" -czf - base.dump fichiers.tar.gz infos.json
}

# Supprime un client en gardant une archive (base + fichiers) dans archives/.
cmd_supprimer() {
  local nom="${1:-}" ok="${2:-}"
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance supprimer <nom existant> --oui"
  [ "${ok}" = "--oui" ] || die "Ajoute --oui pour confirmer la suppression de « ${nom} »."
  local db arch
  db="$(base "${nom}")"
  arch="${ARCHIVES}/${nom}-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "${arch}"
  info "Archive de la base et des fichiers dans ${arch}…"
  docker exec "${PG}" pg_dump -U postgres -Fc "${db}" > "${arch}/base.dump"
  tar -C "${INSTANCES}/${nom}" -czf "${arch}/fichiers.tar.gz" .
  chmod -R go-rwx "${arch}"
  docker rm -f "$(conteneur "${nom}")" >/dev/null 2>&1 || true
  psql_admin <<SQL
DROP DATABASE IF EXISTS ${db};
DROP ROLE IF EXISTS ${db};
SQL
  if grep -q '^CONNEXION=authentik' "${INSTANCES}/${nom}/instance.conf"; then
    info "Retrait du client dans Authentik (les comptes qui ne servent plus sont désactivés)…"
    passerelle client-supprimer "${nom}" >/dev/null || echo "⚠️  Authentik : client « ${nom} » non retiré. À refaire : docker exec recipelog-passerelle node cli.mjs client-supprimer ${nom}" >&2
  fi
  if [ -d "$(dossier_sauv "${nom}")" ]; then mv "$(dossier_sauv "${nom}")" "${arch}/sauvegardes"; fi
  rm -rf "${INSTANCES:?}/${nom}"
  info "✅ ${nom} supprimé. Archive (avec ses sauvegardes) : ${arch}"
}

[ "$(id -u)" -eq 0 ] || die "À lancer en root."
mkdir -p "${INSTANCES}" "${ARCHIVES}" "${SAUVEGARDES}"
action="${1:-}"; shift || true
case "${action}" in
  creer) cmd_creer "$@" ;;
  liste) cmd_liste "$@" ;;
  suspendre) cmd_suspendre "$@" ;;
  reactiver) cmd_reactiver "$@" ;;
  options) cmd_options "$@" ;;
  essai) cmd_essai "$@" ;;
  verifier-essais) cmd_verifier_essais ;;
  equipe) cmd_equipe "$@" ;;
  inviter) cmd_inviter "$@" ;;
  quota) cmd_quota "$@" ;;
  brancher-authentik) cmd_brancher "$@" ;;
  mettre-a-jour) cmd_maj "$@" ;;
  redemarrer) cmd_redemarrer "$@" ;;
  journaux) cmd_journaux "$@" ;;
  supprimer) cmd_supprimer "$@" ;;
  sauvegarder) cmd_sauvegarder "$@" ;;
  sauvegardes) cmd_sauvegardes "$@" ;;
  restaurer) cmd_restaurer "$@" ;;
  tester-sauvegarde) cmd_tester_sauvegarde "$@" ;;
  exporter) cmd_exporter "$@" ;;
  *) sed -n '2,37p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
