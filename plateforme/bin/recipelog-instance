#!/usr/bin/env bash
# ============================================================
# recipelog-instance : gérer les clients de la plateforme RecipeLog.
# Un client = une base dans le PostgreSQL partagé + un conteneur RecipeLog
# sur <nom>.<domaine>. Le panel admin (lot 2) fera la même chose en 1 clic.
#
#   recipelog-instance creer <nom> [--canal instance|beta-instance|…] [--responsable email]
#                                  [--max N] [--essai jours] [--sans-mcp] [--admin email]
#                                  [--demo --sans-authentik]   (sans Authentik : démo seulement)
#   recipelog-instance liste [--json]
#   recipelog-instance suspendre <nom> | reactiver <nom> [--essai jours]
#   recipelog-instance options <nom> --mcp oui|non
#   recipelog-instance essai <nom> <jours|0>     (0 = plus d'essai : client normal)
#   recipelog-instance verifier-essais           (met en pause les essais terminés)
#   recipelog-instance equipe <nom>
#   recipelog-instance inviter <nom> <email> [nom affiché]
#   recipelog-instance quota <nom> <N|0>          (0 = pas de plafond)
#   recipelog-instance brancher-authentik <nom> [--responsable email] [--max N]
#   recipelog-instance mettre-a-jour <nom>|--tous   (sauvegarde avant, retour arrière si ça rate)
#   recipelog-instance canal <nom> <canal>          (change sa version puis le met à jour)
#   recipelog-instance redemarrer <nom>
#   recipelog-instance journaux <nom>
#   recipelog-instance supprimer <nom> --oui
#   recipelog-instance sauvegarder <nom>|--tous [--etiquette mot]
#   recipelog-instance sauvegarder-plateforme      (comptes Authentik + réglages .env)
#   recipelog-instance sauvegardes <nom> [--json]
#   recipelog-instance restaurer <nom> <sauvegarde> --oui
#   recipelog-instance tester-sauvegarde <nom>|--tous
#   recipelog-instance exporter <nom> <sauvegarde> > fichier.tar.gz   (sans mots de passe)
#   recipelog-instance importer <nom> <archive.tar.gz> --oui [--sans-fichiers]
#                                                  (déménagement : voir exporter-ancien.sh)
#   recipelog-instance menage                      (vieilles images Docker, vieilles archives)
#   recipelog-instance inviter-comptes <nom>     (invite les comptes actifs après un import)
#   recipelog-instance demo-figer <nom> | demo-remettre <nom>|--toutes
#   recipelog-instance vitrine maj | bandeau "texte" | demandes [--json] | traitee <clé>
#
# Réglages lus dans /srv/recipelog/.env (écrit par install.sh).
# Chaque client a son dossier /srv/recipelog/instances/<nom>/ :
#   instance.conf  canal, date de création, connexion (authentik ou cloudflare),
#                  pause (SUSPENDU=1), fin d'essai (ESSAI_FIN), MCP (oui/non)
#   instance.env   variables du conteneur (mot de passe de sa base, réglages
#                  de connexion Authentik : voir ../connexion.md)
#   uploads/       photos et factures envoyées
# Sauvegardes de chaque client dans /srv/recipelog/sauvegardes/<nom>/.
# Une seule commande qui modifie à la fois (verrou /srv/recipelog/.verrou) : une
# commande lancée à la main attend la fin de la sauvegarde de nuit, et l'inverse.
# ============================================================
set -euo pipefail

DONNEES="${DONNEES:-/srv/recipelog}"
ENV_FILE="${DONNEES}/.env"
[ -r "${ENV_FILE}" ] || { echo "❌ ${ENV_FILE} introuvable : lancer d'abord install.sh." >&2; exit 1; }
set -a
# shellcheck source=/dev/null
. "${ENV_FILE}"
set +a

DOMAINE="${DOMAINE:-recipelog.cc}"
IMAGE="${IMAGE:-ghcr.io/supernon0/recipelog}"
INSTANCES="${DONNEES}/instances"
ARCHIVES="${DONNEES}/archives"
SAUVEGARDES="${DONNEES}/sauvegardes"
GARDER_JOURS="${SAUVEGARDE_JOURS:-7}"
GARDER_SEMAINES="${SAUVEGARDE_SEMAINES:-4}"
GARDER_MOIS="${SAUVEGARDE_MOIS:-6}"
PG="recipelog-postgres"
RESERVES=" www admin auth demo api status mail smtp traefik panel plateforme "
MEMOIRE="${INSTANCE_MEMOIRE:-1g}"
# Un client ne peut pas prendre toute la machine : processeur, processus, connexions à la base.
CPUS="${INSTANCE_CPUS:-1.5}"
PIDS="${INSTANCE_PIDS:-512}"
CONNEXIONS_APPLI="${INSTANCE_CONNEXIONS:-5}"   # connexions ouvertes par l'appli (Prisma)
CONNEXIONS_MAX="${INSTANCE_CONNEXIONS_MAX:-15}" # plafond côté PostgreSQL pour ce client
# Sauvegardes : place libre exigée avant de commencer (Mo), et plafond d'occupation du disque (%).
LIBRE_MIN_MO="${SAUVEGARDE_LIBRE_MIN_MO:-2048}"
DISQUE_MAX="${SAUVEGARDE_DISQUE_MAX:-95}"
# Clients supprimés : leur archive est effacée après ce nombre de jours (0 = jamais).
ARCHIVES_JOURS="${ARCHIVES_GARDER_JOURS:-365}"
CANAL_DEFAUT="${CANAL_DEFAUT:-instance}"
# Canaux = étiquettes de l'image, construites par GitHub (.github/workflows/docker-image.yml) :
#   instance       branche « instance »      : les clients
#   beta-instance  branche « beta-instance » : la bêta (l'instance de Noë), essayée avant les clients
#   plateforme     branche « plateforme »    : l'ancien canal, avant le 17/11/2026
#   beta, stable   branches main et stable   : l'appli des sites LXC, sans la connexion Authentik
CANAUX_RE='^(instance|beta-instance|plateforme|beta|stable)$'

die() { echo "❌ $*" >&2; exit 1; }
info() { echo "==> $*"; }

nom_valide() {
  local n="$1"
  [[ "${n}" =~ ^[a-z0-9][a-z0-9-]{0,30}[a-z0-9]$ ]] || die "Nom « ${n} » refusé : 2 à 32 caractères, minuscules, chiffres et tirets (pas au début ni à la fin)."
  [[ "${RESERVES}" != *" ${n} "* ]] || die "« ${n} » est réservé à la plateforme."
}
conteneur() { echo "rl-$1"; }
# aleatoire <octets> : secret en hexadécimal (sans dépendre d'openssl).
aleatoire() { head -c "$1" /dev/urandom | od -An -tx1 | tr -d ' \n'; }
# Télécharge l'image ; sans réseau, garde celle déjà présente sur la machine.
tirer() {
  docker pull -q "$1" >/dev/null 2>&1 && return 0
  docker image inspect "$1" >/dev/null 2>&1 || die "Impossible de télécharger $1."
  echo "⚠️  Téléchargement de $1 impossible : la version déjà présente est utilisée." >&2
}
base() { echo "rl_${1//-/_}"; }
existe() { [ -d "${INSTANCES}/$1" ]; }

# Commande d'administration de la passerelle (seule à parler à Authentik).
passerelle() { docker exec recipelog-passerelle node cli.mjs "$@"; }
passerelle_ok() { docker inspect -f '{{.State.Running}}' recipelog-passerelle 2>/dev/null | grep -q true; }

# Crée le client dans Authentik et ajoute ses réglages de connexion à instance.env.
# brancher <nom> <max> <responsable>
brancher() {
  local nom="$1" max="$2" resp="$3" dir="${INSTANCES}/$1" reglages
  passerelle_ok || die "La passerelle ne tourne pas (recipelog-plateforme ps)."
  info "Client « ${nom} » dans Authentik…"
  reglages="$(passerelle client-creer "${nom}" "${max}" "https://${nom}.${DOMAINE}" --env)" || die "Authentik a refusé la création du client « ${nom} »."
  sed -i '/^RECIPELOG_AUTH_MODE=/d;/^RECIPELOG_URL=/d;/^OIDC_/d;/^RECIPELOG_SESSION_SECRET=/d;/^RECIPELOG_PASSERELLE_/d;/^RECIPELOG_RESPONSABLE_EMAIL=/d' "${dir}/instance.env"
  umask 077
  {
    echo "RECIPELOG_AUTH_MODE=oidc"
    echo "RECIPELOG_URL=https://${nom}.${DOMAINE}"
    echo "${reglages}"
    echo "RECIPELOG_SESSION_SECRET=$(aleatoire 32)"
    echo "RECIPELOG_PASSERELLE_URL=http://recipelog-passerelle:8000"
    [ -n "${resp}" ] && echo "RECIPELOG_RESPONSABLE_EMAIL=${resp}"
  } >> "${dir}/instance.env"
  umask 022
  sed -i '/^CONNEXION=/d' "${dir}/instance.conf"
  echo "CONNEXION=authentik" >> "${dir}/instance.conf"
}

# Invite le responsable (email « Choisis ton mot de passe »).
inviter_responsable() {
  local nom="$1" resp="$2"
  [ -n "${resp}" ] || return 0
  if passerelle inviter "${nom}" "${resp}" >/dev/null; then
    info "Invitation envoyée à ${resp}."
  else
    echo "⚠️  Invitation de ${resp} impossible. À relancer : recipelog-instance inviter ${nom} ${resp}" >&2
  fi
}

# Lit / écrit une ligne CLE=valeur de instance.conf.
conf_lire() { sed -n "s/^$2=//p" "${INSTANCES}/$1/instance.conf" 2>/dev/null | tail -1; }
conf_ecrire() { # conf_ecrire <nom> <CLE> [valeur]  (sans valeur : retire la ligne)
  local f="${INSTANCES}/$1/instance.conf"
  sed -i "/^$2=/d" "${f}"
  [ $# -lt 3 ] || echo "$2=$3" >> "${f}"
}
suspendu() { [ "$(conf_lire "$1" SUSPENDU)" = 1 ]; }

verifier_email() { [[ "$1" =~ ^[^[:space:]@]+@[^[:space:]@]+\.[^[:space:]@]+$ ]] || die "Adresse email invalide : $1"; }
verifier_max() { [[ "$1" =~ ^[0-9]+$ ]] || die "Nombre de comptes invalide : $1 (0 = pas de plafond)."; }

psql_admin() { docker exec -i "${PG}" psql -v ON_ERROR_STOP=1 -q -U postgres "$@"; }

# État du conteneur d'un client : healthy, starting, unhealthy, running, exited… ou « absent ».
# (docker inspect écrit une ligne vide quand le conteneur n'existe pas : on ne garde que la 1re.)
etat_brut() {
  local e
  e="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{else}}{{.State.Status}}{{end}}' "$(conteneur "$1")" 2>/dev/null | head -1)" || true
  echo "${e:-absent}"
}

# Image que doit utiliser un client : la version exacte gardée après un retour
# arrière (IMAGE_FIXE), sinon la dernière de son canal.
image_de() {
  local fixe canal
  fixe="$(conf_lire "$1" IMAGE_FIXE)"
  canal="$(conf_lire "$1" CANAL)"
  echo "${fixe:-${IMAGE}:${canal:-${CANAL_DEFAUT}}}"
}

# Lance (ou relance) le conteneur d'un client à partir de son dossier.
# $2 facultatif : image exacte à utiliser (retour en arrière).
lancer() {
  local nom="$1" image_forcee="${2:-}" dir="${INSTANCES}/$1" c canal image
  c="$(conteneur "${nom}")"
  canal="$(conf_lire "${nom}" CANAL)"
  image="${image_forcee:-$(image_de "${nom}")}"
  docker rm -f "${c}" >/dev/null 2>&1 || true
  docker run -d --name "${c}" \
    --network recipelog \
    --restart unless-stopped \
    --memory "${MEMOIRE}" \
    --cpus "${CPUS}" \
    --pids-limit "${PIDS}" \
    --shm-size 256m \
    --env-file "${dir}/instance.env" \
    -e RECIPELOG_PDF_URL=http://recipelog-pdf:3000 \
    -v "${dir}/uploads:/data/uploads" \
    --label "recipelog.instance=${nom}" \
    --label "recipelog.canal=${canal}" \
    --label "traefik.enable=true" \
    --label "traefik.http.routers.${c}.rule=Host(\`${nom}.${DOMAINE}\`)" \
    --label "traefik.http.routers.${c}.entrypoints=web" \
    --label "traefik.http.routers.${c}.middlewares=securite@file,limite@file" \
    --label "traefik.http.services.${c}.loadbalancer.server.port=3000" \
    "${image}" >/dev/null
}

# Attend que le conteneur réponde (migrations + démarrage). 0 = prêt.
attendre() {
  local etat
  for _ in $(seq 1 90); do
    etat="$(etat_brut "$1")"
    case "${etat}" in
      healthy) return 0 ;;
      exited|dead|absent) return 1 ;;
    esac
    # Un conteneur qui plante et repart en boucle ne deviendra pas sain : inutile d'attendre 3 minutes.
    [ "$(docker inspect -f '{{.RestartCount}}' "$(conteneur "$1")" 2>/dev/null | head -1)" -ge 4 ] 2>/dev/null && return 1
    sleep 2
  done
  return 1
}

# ------------------------------------------------------------ création
# Une création qui échoue en route est défaite en entier (base, dossier, Authentik) :
# on peut la relancer avec le même nom. Seul ce que CETTE commande a créé est retiré.
CREATION_NOM="" CREATION_BASE=0 CREATION_AUTHENTIK=0
defaire_creation() {
  local code=$? nom="${CREATION_NOM}" db
  [ -n "${nom}" ] && [ "${code}" -ne 0 ] || return 0
  CREATION_NOM=""
  echo "↩️  La création de « ${nom} » a échoué : je retire ce qui avait été créé…" >&2
  docker rm -f "$(conteneur "${nom}")" >/dev/null 2>&1 || true
  if [ "${CREATION_BASE}" = 1 ]; then
    db="$(base "${nom}")"
    psql_admin -c "DROP DATABASE IF EXISTS ${db} WITH (FORCE);" >/dev/null 2>&1 || true
    psql_admin -c "DROP ROLE IF EXISTS ${db};" >/dev/null 2>&1 || true
  fi
  if [ "${CREATION_AUTHENTIK}" = 1 ]; then passerelle client-supprimer "${nom}" >/dev/null 2>&1 || true; fi
  rm -rf "${INSTANCES:?}/${nom}"
  echo "   Rien n'est resté : tu peux relancer la création de « ${nom} »." >&2
}

cmd_creer() {
  local nom="" canal="${CANAL_DEFAUT}" admin="${ADMIN_EMAILS:-}" demo=0 resp="" max=0 authentik=1 essai=0 mcp=oui
  while [ $# -gt 0 ]; do
    case "$1" in
      --canal) canal="${2:-}"; shift 2 ;;
      --admin) admin="${2:-}"; shift 2 ;;
      --responsable) resp="${2:-}"; shift 2 ;;
      --max) max="${2:-}"; shift 2 ;;
      --sans-authentik) authentik=0; shift ;;
      --essai) essai="${2:-}"; shift 2 ;;
      --sans-mcp) mcp=non; shift ;;
      --demo) demo=1; shift ;;
      -*) die "Option inconnue : $1" ;;
      *) [ -z "${nom}" ] || die "Un seul nom à la fois."; nom="$1"; shift ;;
    esac
  done
  [ -n "${nom}" ] || die "Usage : recipelog-instance creer <nom> [--canal …] [--responsable email] [--max N] [--admin email] [--demo] [--sans-authentik]"
  if [ "${nom}" = demo ] && [ "${demo}" = 1 ]; then :; else nom_valide "${nom}"; fi
  [ -z "${resp}" ] || verifier_email "${resp}"
  verifier_max "${max}"
  [[ "${essai}" =~ ^[0-9]+$ ]] || die "Durée d'essai invalide : ${essai} (en jours)."
  # Sans Authentik, un site est ouvert à tout internet : réservé à la démo publique.
  [ "${authentik}" = 1 ] || [ "${demo}" = 1 ] || die "--sans-authentik ne sert qu'à la démo (avec --demo) : sans connexion, le site serait ouvert à tout internet."
  [ "${authentik}" = 0 ] || passerelle_ok || die "La passerelle ne tourne pas (recipelog-plateforme ps)."
  [[ "${canal}" =~ ${CANAUX_RE} ]] || die "Canal « ${canal} » inconnu (instance ou beta-instance)."
  existe "${nom}" && die "Le client « ${nom} » existe déjà."

  local dir="${INSTANCES}/${nom}" db mdp
  db="$(base "${nom}")"
  mdp="$(aleatoire 24)"

  # L'image d'abord : si elle manque, rien n'a encore été créé.
  info "Téléchargement de ${IMAGE}:${canal}…"
  tirer "${IMAGE}:${canal}"
  [ -z "$(docker exec "${PG}" psql -U postgres -tAc "SELECT 1 FROM pg_roles WHERE rolname = '${db}' UNION SELECT 1 FROM pg_database WHERE datname = '${db}'")" ] \
    || die "Une base « ${db} » existe déjà dans PostgreSQL (reste d'un ancien client ?). Je n'y touche pas : choisis un autre nom, ou retire-la à la main."

  CREATION_NOM="${nom}"
  trap defaire_creation EXIT
  info "Base ${db} dans PostgreSQL…"
  CREATION_BASE=1
  psql_admin <<SQL
CREATE ROLE ${db} LOGIN PASSWORD '${mdp}' CONNECTION LIMIT ${CONNEXIONS_MAX};
CREATE DATABASE ${db} OWNER ${db};
REVOKE ALL ON DATABASE ${db} FROM PUBLIC;
SQL
  psql_admin -d "${db}" -c "CREATE EXTENSION IF NOT EXISTS pg_trgm;"

  info "Dossier ${dir}…"
  mkdir -p "${dir}/uploads"
  chown 1000:1000 "${dir}/uploads" # utilisateur « node » de l'image
  umask 077
  cat > "${dir}/instance.conf" <<CONF
CANAL=${canal}
CREE_LE=$(date -u +%Y-%m-%dT%H:%M:%SZ)
CONNEXION=cloudflare
MCP=${mcp}
$([ "${demo}" = 1 ] && echo "DEMO=1")
$([ "${essai}" -gt 0 ] && echo "ESSAI_FIN=$(date -u -d "+${essai} days" +%Y-%m-%d)")
CONF
  {
    # connection_limit : sans lui, chaque site ouvre une dizaine de connexions et
    # PostgreSQL sature vers 8 clients actifs.
    echo "DATABASE_URL=postgresql://${db}:${mdp}@${PG}:5432/${db}?connection_limit=${CONNEXIONS_APPLI}"
    echo "RECIPELOG_INSTANCE=${nom}"
    echo "RECIPELOG_ADMIN_EMAILS=${admin}"
    if [ "${demo}" = 1 ]; then echo "RECIPELOG_DEMO=1"; fi
    if [ "${mcp}" = non ]; then echo "RECIPELOG_MCP=0"; fi
  } > "${dir}/instance.env"
  umask 022
  if [ "${authentik}" = 1 ]; then
    brancher "${nom}" "${max}" "${resp}"
    CREATION_AUTHENTIK=1
  fi

  info "Démarrage de $(conteneur "${nom}")…"
  lancer "${nom}"
  if ! attendre "${nom}"; then
    docker logs --tail 40 "$(conteneur "${nom}")" >&2 || true
    die "${nom} ne démarre pas (journaux ci-dessus)."
  fi
  CREATION_NOM=""
  trap - EXIT
  info "✅ ${nom} est prêt : https://${nom}.${DOMAINE}"
  if [ "${authentik}" = 1 ]; then
    inviter_responsable "${nom}" "${resp}"
  else
    echo "   Démo ouverte à tous. Prépare-la, puis : recipelog-instance demo-figer ${nom}"
    if [ -d "${DONNEES}/vitrine/reglages" ]; then vitrine_reglages; fi
  fi
}

# Passe un client existant (créé sans Authentik) sur la connexion par Authentik.
cmd_brancher() {
  local nom="" resp="" max=0
  while [ $# -gt 0 ]; do
    case "$1" in
      --responsable) resp="${2:-}"; shift 2 ;;
      --max) max="${2:-}"; shift 2 ;;
      -*) die "Option inconnue : $1" ;;
      *) nom="$1"; shift ;;
    esac
  done
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance brancher-authentik <nom existant> [--responsable email] [--max N]"
  [ -z "${resp}" ] || verifier_email "${resp}"
  verifier_max "${max}"
  grep -q '^CONNEXION=authentik' "${INSTANCES}/${nom}/instance.conf" && die "« ${nom} » utilise déjà Authentik."
  brancher "${nom}" "${max}" "${resp}"
  lancer "${nom}"
  attendre "${nom}" || die "${nom} ne redémarre pas : recipelog-instance journaux ${nom}"
  inviter_responsable "${nom}" "${resp}"
  info "✅ ${nom} se connecte maintenant par Authentik. Tu peux retirer sa protection Cloudflare Access."
}

cmd_equipe() {
  [ $# -eq 1 ] && existe "$1" || die "Usage : recipelog-instance equipe <nom existant>"
  passerelle equipe "$1"
}

cmd_inviter() {
  [ $# -ge 2 ] && existe "$1" || die "Usage : recipelog-instance inviter <nom existant> <email> [nom affiché]"
  verifier_email "$2"
  passerelle inviter "$@"
}

cmd_quota() {
  [ $# -eq 2 ] && existe "$1" || die "Usage : recipelog-instance quota <nom existant> <N|0>   (0 = pas de plafond)"
  verifier_max "$2"
  passerelle quota "$1" "$2" >/dev/null && info "✅ $1 : $([ "$2" = 0 ] && echo "pas de plafond" || echo "$2 comptes au plus")."
}

etat_conteneur() {
  local e; e="$(etat_brut "$1")"
  [ "${e}" = absent ] && e="arrêté"
  echo "${e}"
}

# Valeur sûre dans du JSON : une seule ligne, sans guillemet, barre oblique inverse ni caractère de contrôle.
j() { printf '%s' "$1" | tr -d '\000-\037"\\' ; }

cmd_liste() {
  local json=0 d nom etat canal cx premier=1 fin aujourdhui
  [ "${1:-}" = "--json" ] && json=1
  aujourdhui="$(date -u +%Y-%m-%d)"
  if [ "${json}" = 1 ]; then
    printf '['
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      nom="$(basename "${d}")"
      [ -r "${d}instance.conf" ] || continue # dossier en cours de création ou abîmé
      [ "${premier}" = 1 ] || printf ','
      premier=0
      fin="$(conf_lire "${nom}" ESSAI_FIN)"
      printf '{"nom":"%s","canal":"%s","connexion":"%s","etat":"%s","adresse":"https://%s.%s","creeLe":"%s","suspendu":%s,"essaiFin":"%s","essaiFini":%s,"mcp":%s,"demo":%s,"versionBloquee":%s}' \
        "$(j "${nom}")" "$(j "$(conf_lire "${nom}" CANAL)")" "$(j "$(conf_lire "${nom}" CONNEXION)")" "$(j "$(etat_conteneur "${nom}")")" \
        "$(j "${nom}")" "$(j "${DOMAINE}")" "$(j "$(conf_lire "${nom}" CREE_LE)")" \
        "$(suspendu "${nom}" && echo true || echo false)" "$(j "${fin}")" \
        "$([ -n "${fin}" ] && [[ "${fin}" < "${aujourdhui}" ]] && echo true || echo false)" \
        "$([ "$(conf_lire "${nom}" MCP)" = non ] && echo false || echo true)" \
        "$([ "$(conf_lire "${nom}" DEMO)" = 1 ] && echo true || echo false)" \
        "$([ -n "$(conf_lire "${nom}" IMAGE_FIXE)" ] && echo true || echo false)"
    done
    printf ']\n'
    return
  fi
  printf "%-20s %-10s %-10s %-10s %s\n" "CLIENT" "CANAL" "CONNEXION" "ÉTAT" "ADRESSE"
  for d in "${INSTANCES}"/*/; do
    [ -d "${d}" ] || continue
    nom="$(basename "${d}")"
    canal="$(conf_lire "${nom}" CANAL)"
    cx="$(conf_lire "${nom}" CONNEXION)"
    etat="$(etat_conteneur "${nom}")"
    suspendu "${nom}" && etat="en pause"
    printf "%-20s %-10s %-10s %-10s %s\n" "${nom}" "${canal}" "${cx:-cloudflare}" "${etat}" "https://${nom}.${DOMAINE}"
  done
}

cmd_suspendre() {
  [ $# -eq 1 ] && existe "$1" || die "Usage : recipelog-instance suspendre <nom existant>"
  suspendu "$1" && { info "$1 est déjà en pause."; return 0; }
  docker stop "$(conteneur "$1")" >/dev/null 2>&1 || true
  conf_ecrire "$1" SUSPENDU 1
  info "⏸️  $1 est en pause : son adresse affiche « site en pause ». Les données sont gardées."
}

# reactiver <nom> [--essai jours] : rouvre un client en pause. Si son essai est terminé,
# il devient un client normal (ou l'essai est prolongé avec --essai), sinon il
# repasserait en pause dans l'heure.
cmd_reactiver() {
  local nom="${1:-}" essai="" fin image
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance reactiver <nom existant> [--essai jours]"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --essai) essai="${2:-}"; [[ "${essai}" =~ ^[0-9]+$ ]] || die "Durée d'essai invalide (en jours)."; shift 2 ;;
      *) die "Option inconnue : $1" ;;
    esac
  done
  if ! suspendu "${nom}"; then
    info "${nom} n'est pas en pause : rien à faire. (Pour le relancer : redemarrer ; pour la dernière version : mettre-a-jour.)"
    return 0
  fi
  fin="$(conf_lire "${nom}" ESSAI_FIN)"
  if [ -n "${essai}" ] && [ "${essai}" -gt 0 ]; then
    conf_ecrire "${nom}" ESSAI_FIN "$(date -u -d "+${essai} days" +%Y-%m-%d)"
    info "${nom} : essai prolongé jusqu'au $(conf_lire "${nom}" ESSAI_FIN) inclus."
  elif [ -n "${fin}" ] && { [ "${essai}" = 0 ] || [[ "${fin}" < "$(date -u +%Y-%m-%d)" ]]; }; then
    conf_ecrire "${nom}" ESSAI_FIN
    info "${nom} : l'essai est terminé, il devient un client normal (plus de pause automatique)."
  fi
  image="$(image_de "${nom}")"
  [[ "${image}" == sha256:* ]] || tirer "${image}"
  conf_ecrire "${nom}" SUSPENDU
  lancer "${nom}"
  if attendre "${nom}"; then
    info "✅ ${nom} est de nouveau en ligne."
  else
    docker stop "$(conteneur "${nom}")" >/dev/null 2>&1 || true
    conf_ecrire "${nom}" SUSPENDU 1
    die "${nom} ne démarre pas, il reste en pause : recipelog-instance journaux ${nom}"
  fi
}

cmd_options() {
  local nom="${1:-}" mcp=""
  shift || true
  while [ $# -gt 0 ]; do
    case "$1" in
      --mcp) mcp="${2:-}"; shift 2 ;;
      *) die "Option inconnue : $1" ;;
    esac
  done
  [ -n "${nom}" ] && existe "${nom}" && [[ "${mcp}" =~ ^(oui|non)$ ]] || die "Usage : recipelog-instance options <nom existant> --mcp oui|non"
  local f="${INSTANCES}/${nom}/instance.env"
  sed -i '/^RECIPELOG_MCP=/d' "${f}"
  [ "${mcp}" = non ] && echo "RECIPELOG_MCP=0" >> "${f}"
  conf_ecrire "${nom}" MCP "${mcp}"
  if ! suspendu "${nom}"; then
    lancer "${nom}"
    attendre "${nom}" || die "${nom} ne redémarre pas : recipelog-instance journaux ${nom}"
  fi
  info "✅ ${nom} : accès MCP $([ "${mcp}" = oui ] && echo permis || echo coupé)."
}

cmd_essai() {
  [ $# -eq 2 ] && existe "$1" && [[ "$2" =~ ^[0-9]+$ ]] || die "Usage : recipelog-instance essai <nom existant> <jours|0>"
  if [ "$2" = 0 ]; then
    conf_ecrire "$1" ESSAI_FIN
    info "✅ $1 n'est plus en essai."
  else
    conf_ecrire "$1" ESSAI_FIN "$(date -u -d "+$2 days" +%Y-%m-%d)"
    info "✅ $1 : essai jusqu'au $(conf_lire "$1" ESSAI_FIN) inclus."
  fi
}

# Met en pause les clients dont l'essai est fini (lancé toutes les heures par le moteur).
cmd_verifier_essais() {
  local d nom fin aujourdhui
  aujourdhui="$(date -u +%Y-%m-%d)"
  for d in "${INSTANCES}"/*/; do
    [ -d "${d}" ] || continue
    nom="$(basename "${d}")"
    fin="$(conf_lire "${nom}" ESSAI_FIN)"
    [ -n "${fin}" ] || continue
    suspendu "${nom}" && continue
    if [[ "${fin}" < "${aujourdhui}" ]]; then
      info "Essai de ${nom} terminé le ${fin} : mise en pause."
      cmd_suspendre "${nom}"
    fi
  done
}

# Met à jour un client. Dans l'ordre : nouvelle image, sauvegarde « avant-maj »,
# démarrage de la nouvelle version. Si elle ne démarre pas : la base d'avant est
# remise (une nouvelle version peut avoir commencé à la modifier), l'ancienne
# version est relancée et gardée (IMAGE_FIXE) jusqu'à la prochaine mise à jour
# réussie : un redémarrage ne remet donc pas la version cassée.
# $2 = lot : dans « --tous », un client dont la version disponible a déjà échoué est sauté.
maj_un() {
  local nom="$1" mode="${2:-}" c ancienne canal nouvelle secu db
  existe "${nom}" || die "Client « ${nom} » inconnu."
  if suspendu "${nom}"; then
    info "${nom} est en pause : il prendra la dernière version à sa réactivation."
    conf_ecrire "${nom}" IMAGE_FIXE
    return 0
  fi
  c="$(conteneur "${nom}")"
  canal="$(conf_lire "${nom}" CANAL)"
  ancienne="$(docker inspect -f '{{.Image}}' "${c}" 2>/dev/null | head -1)" || true
  info "${nom} : téléchargement de ${IMAGE}:${canal}…"
  tirer "${IMAGE}:${canal}"
  nouvelle="$(docker image inspect -f '{{.Id}}' "${IMAGE}:${canal}")"
  if [ -n "${ancienne}" ] && [ "${nouvelle}" = "${ancienne}" ] && [ "$(etat_brut "${nom}")" = healthy ]; then
    conf_ecrire "${nom}" IMAGE_FIXE
    info "${nom} : déjà à jour."
    return 0
  fi
  if [ "${mode}" = lot ] && [ "$(conf_lire "${nom}" IMAGE_REFUSEE)" = "${nouvelle}" ]; then
    info "${nom} : la version disponible est celle qui a déjà échoué chez lui, il garde la sienne. (Pour réessayer : mettre-a-jour ${nom}.)"
    return 0
  fi
  info "${nom} : sauvegarde avant la mise à jour…"
  if ! secu="$(sauvegarder_un "${nom}" avant-maj --sans-rotation)"; then
    echo "❌ ${nom} : sauvegarde ratée, la mise à jour n'est pas faite (rien n'a changé)." >&2
    return 1
  fi
  lancer "${nom}" "${IMAGE}:${canal}"
  if attendre "${nom}"; then
    conf_ecrire "${nom}" IMAGE_FIXE
    conf_ecrire "${nom}" IMAGE_REFUSEE
    info "✅ ${nom} : mis à jour."
    return 0
  fi
  echo "⚠️  ${nom} ne redémarre pas avec la nouvelle version :" >&2
  docker logs --tail 30 "${c}" >&2 || true
  conf_ecrire "${nom}" IMAGE_REFUSEE "${nouvelle}"
  if [ -n "${ancienne}" ]; then
    info "${nom} : retour à la version précédente, avec la base d'avant la mise à jour (${secu})…"
    docker rm -f "${c}" >/dev/null 2>&1 || true
    db="$(base "${nom}")"
    charger_base "${db}" "${db}" "$(dossier_sauv "${nom}")/${secu}/base.dump" \
      || echo "❌ ${nom} : la base d'avant n'a pas pu être remise (sauvegarde ${secu} à restaurer à la main)." >&2
    conf_ecrire "${nom}" IMAGE_FIXE "${ancienne}"
    lancer "${nom}"
    if attendre "${nom}"; then
      info "${nom} : version précédente remise. Elle est gardée jusqu'à la prochaine mise à jour réussie."
    else
      echo "❌ ${nom} : la version précédente ne redémarre pas non plus. Sauvegarde d'avant : ${secu}" >&2
    fi
  fi
  return 1
}

cmd_maj() {
  [ $# -ge 1 ] || die "Usage : recipelog-instance mettre-a-jour <nom>|--tous"
  if [ "$1" = "--tous" ]; then
    local d
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      maj_un "$(basename "${d}")" lot || die "Arrêt : les clients suivants n'ont pas été mis à jour."
    done
    menage_images
  elif [ "${2:-}" = "--lot" ]; then
    # Appelé par le panel (« Tout mettre à jour »), client après client : le ménage est fait à la fin.
    maj_un "$1" lot
  else
    maj_un "$1"
    menage_images
  fi
}

# canal : passe un client sur une autre version (instance ↔ beta-instance), puis le met
# à jour comme « mettre-a-jour » (sauvegarde avant, retour arrière si ça rate). Si la
# nouvelle version ne démarre pas, il est remis sur son canal d'avant.
cmd_canal() {
  [ $# -eq 2 ] && existe "$1" || die "Usage : recipelog-instance canal <nom existant> <instance|beta-instance>"
  local nom="$1" nouveau="$2" ancien
  [[ "${nouveau}" =~ ${CANAUX_RE} ]] || die "Canal « ${nouveau} » inconnu (instance ou beta-instance)."
  ancien="$(conf_lire "${nom}" CANAL)"
  if [ "${ancien}" = "${nouveau}" ]; then
    info "${nom} est déjà sur « ${nouveau} »."
    return 0
  fi
  # L'image d'abord : si elle n'existe pas encore, rien ne change.
  info "${nom} : téléchargement de ${IMAGE}:${nouveau}…"
  tirer "${IMAGE}:${nouveau}"
  conf_ecrire "${nom}" CANAL "${nouveau}"
  conf_ecrire "${nom}" IMAGE_REFUSEE
  info "${nom} : canal « ${ancien:-?} » → « ${nouveau} »."
  if ! maj_un "${nom}"; then
    conf_ecrire "${nom}" CANAL "${ancien}"
    die "${nom} : la mise à jour a raté, il reste sur « ${ancien} » avec sa version d'avant."
  fi
  menage_images
}

menage_images() {
  docker image prune -f --filter "until=168h" >/dev/null 2>&1 || true
}

# menage : vieilles images Docker, archives des clients supprimés depuis longtemps,
# restes de sauvegardes interrompues. Lancé chaque nuit par le moteur.
cmd_menage() {
  local n=0 d
  menage_images
  if [ "${ARCHIVES_JOURS}" -gt 0 ] && [ -d "${ARCHIVES}" ]; then
    while IFS= read -r d; do
      [ -n "${d}" ] || continue
      rm -rf "${d}"
      info "Archive effacée (client supprimé il y a plus de ${ARCHIVES_JOURS} jours) : $(basename "${d}")"
      n=$((n + 1))
    done < <(find "${ARCHIVES}" -mindepth 1 -maxdepth 1 -type d -mtime "+${ARCHIVES_JOURS}")
  fi
  find "${SAUVEGARDES}" -mindepth 2 -maxdepth 2 -type d -name '*.partiel' -mmin +720 -exec rm -rf {} + 2>/dev/null || true
  if [ "${n}" -gt 0 ]; then info "Ménage fait (${n} archive(s) effacée(s))."; else info "Ménage fait."; fi
}

cmd_redemarrer() {
  [ $# -eq 1 ] && existe "$1" || die "Usage : recipelog-instance redemarrer <nom existant>"
  suspendu "$1" && die "$1 est en pause : recipelog-instance reactiver $1"
  lancer "$1"
  attendre "$1" && info "✅ $1 a redémarré." || die "$1 ne démarre pas : recipelog-instance journaux $1"
}

cmd_journaux() {
  [ $# -eq 1 ] || die "Usage : recipelog-instance journaux <nom>"
  docker logs -f --tail 100 "$(conteneur "$1")"
}

# ------------------------------------------------------------ sauvegardes (lot 3)
# Une sauvegarde = un dossier sauvegardes/<nom>/<AAAAMMJJ-HHMMSS>/ :
#   base.dump        la base du client (pg_dump, format compressé)
#   fichiers/        uploads/ (photos et factures) et instance.conf. Un fichier qui n'a
#                    pas changé depuis la sauvegarde d'avant n'est pas recopié : c'est un
#                    lien vers le même fichier (rsync --link-dest), sans place en plus.
#                    17 sauvegardes d'un client ne prennent donc guère plus qu'une seule.
#   reglages.tar.gz  instance.env (mots de passe : jamais dans un export)
#   infos.json       date, étiquette, version, tailles, nombre de fichiers
# Rotation : TOUTES celles des GARDER_JOURS derniers jours ; avant, la plus récente
# de chaque semaine (GARDER_SEMAINES semaines) et de chaque mois (GARDER_MOIS mois).
dossier_sauv() { echo "${SAUVEGARDES}/$1"; }
id_valide() { [[ "$1" =~ ^[0-9]{8}-[0-9]{6}$ ]] || die "Sauvegarde « $1 » inconnue."; }
# Identifiants des sauvegardes d'un client, la plus récente d'abord.
ids_sauvegardes() {
  local racine; racine="$(dossier_sauv "$1")"
  [ -d "${racine}" ] || return 0
  find "${racine}" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}' -printf '%f\n' | sort -r
}
nouvel_id() { # nouvel_id <dossier> : identifiant libre (un par seconde)
  local id; id="$(date -u +%Y%m%d-%H%M%S)"
  while [ -e "$1/${id}" ] || [ -e "$1/${id}.partiel" ]; do sleep 1; id="$(date -u +%Y%m%d-%H%M%S)"; done
  echo "${id}"
}

version_client() {
  docker exec "$(conteneur "$1")" node -e 'fetch("http://127.0.0.1:3000/api/health").then(r=>r.json()).then(j=>console.log(j.version||"")).catch(()=>{})' 2>/dev/null | head -1 || true
}

# Assez de place pour sauvegarder ? Un disque plein arrête la base de TOUS les clients.
disque_ok() {
  local libre pct
  read -r libre pct < <(df -Pm "${SAUVEGARDES}" | awk 'NR==2 { sub("%", "", $5); print $4, $5 }') || true
  [ "${libre:-0}" -ge "${LIBRE_MIN_MO}" ] && [ "${pct:-100}" -lt "${DISQUE_MAX}" ]
}
disque_texte() { df -Ph "${SAUVEGARDES}" | awk 'NR==2 { print $5 " utilisés, " $4 " libres" }'; }

# copier_fichiers <nom> <dossier de la sauvegarde en cours> : photos et factures.
copier_fichiers() {
  local nom="$1" tmp="$2" dir="${INSTANCES}/$1" racine prec="" i code=0
  racine="$(dossier_sauv "${nom}")"
  local ids=()
  mapfile -t ids < <(ids_sauvegardes "${nom}")
  for i in "${ids[@]}"; do
    if [ -d "${racine}/${i}/fichiers/uploads" ]; then prec="${racine}/${i}/fichiers/uploads/"; break; fi
  done
  mkdir -p "${tmp}/fichiers/uploads" || return 1
  if command -v rsync >/dev/null 2>&1; then
    rsync -a ${prec:+--link-dest="${prec}"} "${dir}/uploads/" "${tmp}/fichiers/uploads/" || code=$?
    # 24 : un fichier a disparu pendant la copie (photo supprimée au même moment). Sans gravité.
    [ "${code}" = 0 ] || [ "${code}" = 24 ] || return 1
  else
    cp -a "${dir}/uploads/." "${tmp}/fichiers/uploads/" || return 1
  fi
  cp "${dir}/instance.conf" "${tmp}/fichiers/instance.conf" || return 1
}

# sauvegarder_un <nom> [etiquette] [--sans-rotation] : affiche l'identifiant de la sauvegarde.
# Chaque étape est vérifiée : au moindre échec, rien n'est rangé et le code est 1.
sauvegarder_un() {
  local nom="$1" etiquette="${2:-auto}" rotation="${3:-}" dir="${INSTANCES}/$1" racine id tmp db version nb
  racine="$(dossier_sauv "${nom}")"
  db="$(base "${nom}")"
  mkdir -p "${racine}" || return 1
  chmod 700 "${SAUVEGARDES}" "${racine}" || return 1
  # Restes d'une sauvegarde interrompue.
  find "${racine}" -mindepth 1 -maxdepth 1 -type d -name '*.partiel' -exec rm -rf {} + || true
  # Le ménage AVANT : sur un disque presque plein, c'est lui qui refait de la place.
  [ "${rotation}" = "--sans-rotation" ] || elaguer "${nom}" || true
  if ! disque_ok; then
    echo "❌ ${nom} : disque presque plein ($(disque_texte)). Sauvegarde non faite : libère de la place." >&2
    return 1
  fi
  id="$(nouvel_id "${racine}")"
  tmp="${racine}/${id}.partiel"
  mkdir -m 700 "${tmp}" || return 1
  rate() { echo "❌ ${nom} : $1" >&2; rm -rf "${tmp:?}"; return 1; }
  docker exec "${PG}" pg_dump -U postgres -Fc "${db}" > "${tmp}/base.dump" || { rate "la base n'a pas pu être sauvegardée."; return 1; }
  # Le fichier se relit-il ? (disque plein ou coupure en cours d'écriture)
  docker exec -i "${PG}" pg_restore -l < "${tmp}/base.dump" >/dev/null 2>&1 || { rate "le fichier de la base est illisible."; return 1; }
  copier_fichiers "${nom}" "${tmp}" || { rate "les photos et factures n'ont pas pu être sauvegardées."; return 1; }
  tar -C "${dir}" -czf "${tmp}/reglages.tar.gz" instance.env || { rate "les réglages n'ont pas pu être sauvegardés."; return 1; }
  version="$(version_client "${nom}")" || version=""
  nb="$(find "${tmp}/fichiers/uploads" -type f | wc -l)" || nb=0
  printf '{"id":"%s","date":"%s","etiquette":"%s","version":"%s","base":%s,"fichiers":%s,"nbFichiers":%s}\n' \
    "${id}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(j "${etiquette}")" "$(j "${version}")" \
    "$(stat -c %s "${tmp}/base.dump")" "$(du -sb "${tmp}/fichiers" | cut -f1)" "${nb}" > "${tmp}/infos.json" \
    || { rate "le résumé n'a pas pu être écrit."; return 1; }
  grep -q '^{.*}$' "${tmp}/infos.json" || { rate "le résumé est illisible."; return 1; }
  chmod 600 "${tmp}/base.dump" "${tmp}/reglages.tar.gz" "${tmp}/infos.json" || true
  mv "${tmp}" "${racine}/${id}" || { rate "la sauvegarde n'a pas pu être rangée."; return 1; }
  echo "${id}"
}

# Garde la plus récente de chaque jour / semaine / mois dans les limites ; supprime le reste.
elaguer() {
  local racine id jour sem mois limite
  racine="$(dossier_sauv "$1")"
  limite="$(date -u -d "-$((GARDER_JOURS - 1)) days" +%Y%m%d)"
  declare -A semaines=() moisv=() garder=()
  local ids=()
  mapfile -t ids < <(ids_sauvegardes "$1")
  for id in "${ids[@]}"; do
    jour="${id:0:8}"
    sem="$(date -u -d "${jour}" +%G%V)"
    mois="${id:0:6}"
    if [[ ! "${jour}" < "${limite}" ]]; then garder[${id}]=1; continue; fi
    if [ -z "${semaines[${sem}]:-}" ] && [ "${#semaines[@]}" -lt "${GARDER_SEMAINES}" ]; then semaines[${sem}]=1; garder[${id}]=1; fi
    if [ -z "${moisv[${mois}]:-}" ] && [ "${#moisv[@]}" -lt "${GARDER_MOIS}" ]; then moisv[${mois}]=1; garder[${id}]=1; fi
  done
  for id in "${ids[@]}"; do
    [ -n "${garder[${id}]:-}" ] || find "${racine}" -mindepth 1 -maxdepth 1 -type d -name "${id}" -exec rm -rf {} +
  done
}

cmd_sauvegarder() {
  local cible="${1:-}" etiquette="manuelle"
  [ -n "${cible}" ] || die "Usage : recipelog-instance sauvegarder <nom>|--tous [--etiquette mot]"
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --etiquette) [[ "${2:-}" =~ ^[a-z0-9-]{1,30}$ ]] || die "Étiquette invalide."; etiquette="$2"; shift 2 ;;
      *) die "Option inconnue : $1" ;;
    esac
  done
  if [ "${cible}" = "--tous" ]; then
    local d n id echecs=0
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      n="$(basename "${d}")"
      [ "$(conf_lire "${n}" DEMO)" = 1 ] && continue # la démo a sa référence (demo-figer)
      if id="$(sauvegarder_un "${n}" "${etiquette}")"; then info "${n} : sauvegarde ${id}"; else echecs=$((echecs + 1)); fi
    done
    ( cmd_sauvegarder_plateforme ) || echecs=$((echecs + 1))
    [ "${echecs}" -eq 0 ] || die "${echecs} sauvegarde(s) ratée(s)."
  else
    existe "${cible}" || die "Client « ${cible} » inconnu."
    local id; id="$(sauvegarder_un "${cible}" "${etiquette}")" || die "Sauvegarde de ${cible} ratée."
    info "✅ ${cible} : sauvegarde ${id}"
  fi
}

# La plateforme elle-même : tous les comptes et mots de passe (base d'Authentik) et
# les réglages (.env). Sans eux, les bases des clients reviendraient mais plus
# personne ne pourrait se connecter. 14 gardées, dans sauvegardes/_plateforme/.
cmd_sauvegarder_plateforme() {
  local racine="${SAUVEGARDES}/_plateforme" id tmp vieux
  mkdir -p "${racine}"; chmod 700 "${SAUVEGARDES}" "${racine}"
  find "${racine}" -mindepth 1 -maxdepth 1 -type d -name '*.partiel' -exec rm -rf {} + || true
  disque_ok || die "Plateforme : disque presque plein ($(disque_texte)). Sauvegarde non faite."
  id="$(nouvel_id "${racine}")"
  tmp="${racine}/${id}.partiel"
  mkdir -m 700 "${tmp}"
  if ! docker exec "${PG}" pg_dump -U postgres -Fc authentik > "${tmp}/authentik.dump" \
    || ! docker exec -i "${PG}" pg_restore -l < "${tmp}/authentik.dump" >/dev/null 2>&1; then
    rm -rf "${tmp:?}"
    die "Plateforme : la base des comptes (Authentik) n'a pas pu être sauvegardée."
  fi
  cp "${ENV_FILE}" "${tmp}/env"
  chmod 600 "${tmp}/authentik.dump" "${tmp}/env"
  mv "${tmp}" "${racine}/${id}"
  while IFS= read -r vieux; do
    [ -n "${vieux}" ] && rm -rf "${racine:?}/${vieux}"
  done < <(find "${racine}" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}' -printf '%f\n' | sort -r | tail -n +15)
  info "✅ Plateforme : comptes et réglages sauvegardés (${id})."
}

cmd_sauvegardes() {
  local nom="${1:-}" json="${2:-}" racine id
  [ -n "${nom}" ] || die "Usage : recipelog-instance sauvegardes <nom> [--json]"
  racine="$(dossier_sauv "${nom}")"
  local ids=()
  mapfile -t ids < <(ids_sauvegardes "${nom}")
  if [ "${json}" = "--json" ]; then
    local sep="" test="null"
    printf '{"sauvegardes":['
    for id in "${ids[@]}"; do
      # Un résumé vide ou coupé (disque plein) ne doit pas casser la liste entière.
      grep -q '^{.*}$' "${racine}/${id}/infos.json" 2>/dev/null || continue
      printf '%s%s' "${sep}" "$(tr -d '\n' < "${racine}/${id}/infos.json")"; sep=","
    done
    if grep -q '^{.*}$' "${racine}/dernier-test.json" 2>/dev/null; then test="$(tr -d '\n' < "${racine}/dernier-test.json")"; fi
    printf '],"test":%s}\n' "${test}"
  else
    [ "${#ids[@]}" -gt 0 ] || { echo "Aucune sauvegarde pour ${nom}."; return 0; }
    printf '%-17s %-20s %10s %10s\n' SAUVEGARDE ETIQUETTE BASE FICHIERS
    for id in "${ids[@]}"; do
      local f="${racine}/${id}/infos.json"
      printf '%-17s %-20s %10s %10s\n' "${id}" \
        "$(sed -n 's/.*"etiquette":"\([^"]*\)".*/\1/p' "${f}")" \
        "$(numfmt --to=iec "$(sed -n 's/.*"base":\([0-9]*\).*/\1/p' "${f}")" 2>/dev/null || echo '?')" \
        "$(numfmt --to=iec "$(sed -n 's/.*"fichiers":\([0-9]*\).*/\1/p' "${f}")" 2>/dev/null || echo '?')"
    done
    if [ -r "${racine}/dernier-test.json" ]; then echo "Dernier test de restauration : $(cat "${racine}/dernier-test.json")"; fi
  fi
}

# charger_base <base> <rôle> <fichier dump> : recrée la base à partir d'une sauvegarde.
charger_base() {
  local db="$1" role="$2" dump="$3"
  psql_admin >/dev/null <<SQL
SET client_min_messages TO warning;
DROP DATABASE IF EXISTS ${db} WITH (FORCE);
CREATE DATABASE ${db} OWNER ${role};
REVOKE ALL ON DATABASE ${db} FROM PUBLIC;
SQL
  docker exec -i "${PG}" pg_restore -U postgres -d "${db}" --no-owner --role="${role}" --exit-on-error < "${dump}"
}

# preparer_fichiers <nom> <dossier de sauvegarde> : recopie les photos de la sauvegarde
# dans uploads.neuf, SANS toucher aux photos actuelles. Code 1 si la copie échoue.
preparer_fichiers() {
  local dir="${INSTANCES}/$1" sauv="$2" neuf="${INSTANCES}/$1/uploads.neuf"
  rm -rf "${neuf:?}"
  mkdir -p "${neuf}" || return 1
  if [ -d "${sauv}/fichiers/uploads" ]; then
    # Vraie copie (pas de lien) : le site ne doit jamais écrire dans une sauvegarde.
    cp -a "${sauv}/fichiers/uploads" "${neuf}/uploads" || { rm -rf "${neuf:?}"; return 1; }
  elif [ -f "${sauv}/fichiers.tar.gz" ]; then
    tar -C "${neuf}" --no-same-owner -xzf "${sauv}/fichiers.tar.gz" uploads || { rm -rf "${neuf:?}"; return 1; }
  else
    rm -rf "${neuf:?}"
    return 1
  fi
  [ -d "${neuf}/uploads" ] || { rm -rf "${neuf:?}"; return 1; }
}

# basculer_fichiers <nom> : uploads.neuf devient uploads (les anciennes photos ne sont
# effacées qu'une fois les nouvelles en place).
basculer_fichiers() {
  local dir="${INSTANCES}/$1"
  rm -rf "${dir:?}/uploads.avant"
  mv "${dir}/uploads" "${dir}/uploads.avant"
  mv "${dir}/uploads.neuf/uploads" "${dir}/uploads"
  chown -R 1000:1000 "${dir}/uploads"
  rm -rf "${dir:?}/uploads.neuf" "${dir:?}/uploads.avant"
}

# appliquer <nom> <dossier de sauvegarde> : arrête le client, remet base + fichiers.
# Code 2 : les photos de la sauvegarde sont illisibles, RIEN n'a été changé.
# Code 1 : la base n'a pas pu être rechargée (le client est arrêté).
appliquer() {
  local nom="$1" sauv="$2" db
  db="$(base "${nom}")"
  info "Préparation des photos et factures…"
  preparer_fichiers "${nom}" "${sauv}" || return 2
  info "Arrêt de ${nom}…"
  docker rm -f "$(conteneur "${nom}")" >/dev/null 2>&1 || true
  info "Remise de la base…"
  if ! charger_base "${db}" "${db}" "${sauv}/base.dump"; then
    rm -rf "${INSTANCES:?}/${nom}/uploads.neuf"
    return 1
  fi
  info "Remise des photos et factures…"
  basculer_fichiers "${nom}"
}

cmd_restaurer() {
  local nom="${1:-}" id="${2:-}" ok="${3:-}" sauv secu code=0
  [ -n "${nom}" ] && [ -n "${id}" ] || die "Usage : recipelog-instance restaurer <nom> <sauvegarde> --oui"
  existe "${nom}" || die "Client « ${nom} » inconnu."
  id_valide "${id}"
  sauv="$(dossier_sauv "${nom}")/${id}"
  [ -r "${sauv}/base.dump" ] || die "Sauvegarde « ${id} » introuvable pour ${nom}."
  [ "${ok}" = "--oui" ] || die "Ajoute --oui : les données actuelles de ${nom} seront remplacées."
  info "Sauvegarde de sécurité de l'état actuel…"
  secu="$(sauvegarder_un "${nom}" avant-restauration --sans-rotation)" || die "Sauvegarde de sécurité ratée : rien n'a été changé."
  appliquer "${nom}" "${sauv}" || code=$?
  if [ "${code}" = 2 ]; then
    die "Les photos et factures de la sauvegarde ${id} sont illisibles : restauration annulée, rien n'a été changé."
  elif [ "${code}" != 0 ]; then
    echo "❌ La base n'a pas pu être remise. Retour à l'état d'avant (${secu})…" >&2
    charger_base "$(base "${nom}")" "$(base "${nom}")" "$(dossier_sauv "${nom}")/${secu}/base.dump" || true
    suspendu "${nom}" || lancer "${nom}"
    die "Restauration annulée."
  fi
  if suspendu "${nom}"; then
    info "✅ ${nom} restauré (${id}). Il reste en pause."
  else
    lancer "${nom}"
    attendre "${nom}" || die "${nom} ne redémarre pas : recipelog-instance journaux ${nom} (état d'avant : ${secu})"
    info "✅ ${nom} restauré (${id}). État d'avant gardé : ${secu}"
  fi
}

# Restaure la dernière sauvegarde dans une base temporaire pour vérifier qu'elle est bonne.
# La base de test s'appelle test_rl_… : jamais le nom d'une base de client (rl_…). Elle
# appartient au rôle du client et est remplie avec ses droits à lui, pas ceux de PostgreSQL.
tester_un() {
  local nom="$1" racine id essai role recettes="" ok=true raison="" attendu reel
  racine="$(dossier_sauv "${nom}")"
  id="$(ids_sauvegardes "${nom}" | head -1)" || true
  [ -n "${id}" ] || { echo "⚠️  ${nom} : aucune sauvegarde à tester." >&2; return 1; }
  role="$(base "${nom}")"
  essai="test_${role}"
  psql_admin -c "SET client_min_messages TO warning;" -c "DROP DATABASE IF EXISTS ${essai} WITH (FORCE);" -c "CREATE DATABASE ${essai} OWNER ${role};" -c "REVOKE ALL ON DATABASE ${essai} FROM PUBLIC;" >/dev/null
  if ! docker exec -i "${PG}" pg_restore -U postgres -d "${essai}" --no-owner --role="${role}" --exit-on-error < "${racine}/${id}/base.dump" >/dev/null 2>&1; then
    ok=false; raison="la base ne se recharge pas"
  else
    recettes="$(docker exec "${PG}" psql -U postgres -d "${essai}" -tAc 'SELECT count(*) FROM recipes' 2>/dev/null)" || { ok=false; raison="table des recettes absente"; }
  fi
  if ${ok}; then
    if [ -d "${racine}/${id}/fichiers/uploads" ]; then
      attendu="$(sed -n 's/.*"nbFichiers":\([0-9]*\).*/\1/p' "${racine}/${id}/infos.json" 2>/dev/null)" || true
      reel="$(find "${racine}/${id}/fichiers/uploads" -type f | wc -l)" || reel=0
      if [ -n "${attendu}" ] && [ "${attendu}" != "${reel}" ]; then ok=false; raison="il manque des photos ou des factures (${reel} sur ${attendu})"; fi
    elif ! tar -tzf "${racine}/${id}/fichiers.tar.gz" >/dev/null 2>&1; then
      ok=false; raison="photos et factures absentes ou abîmées"
    fi
  fi
  psql_admin -c "SET client_min_messages TO warning;" -c "DROP DATABASE IF EXISTS ${essai} WITH (FORCE);" >/dev/null || true
  printf '{"date":"%s","sauvegarde":"%s","ok":%s,"recettes":%s,"raison":"%s"}\n' \
    "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "${id}" "${ok}" "${recettes:-0}" "$(j "${raison}")" > "${racine}/dernier-test.json"
  if ${ok}; then info "${nom} : sauvegarde ${id} relue sans erreur (${recettes} recettes)."; else echo "❌ ${nom} : sauvegarde ${id} : ${raison}." >&2; return 1; fi
}

# La sauvegarde de la plateforme (comptes) se relit-elle ?
tester_plateforme() {
  local racine="${SAUVEGARDES}/_plateforme" id
  id="$(find "${racine}" -mindepth 1 -maxdepth 1 -type d -regextype posix-extended -regex '.*/[0-9]{8}-[0-9]{6}' -printf '%f\n' 2>/dev/null | sort -r | head -1)" || true
  [ -n "${id}" ] || { echo "⚠️  Plateforme : aucune sauvegarde des comptes à tester." >&2; return 1; }
  if docker exec -i "${PG}" pg_restore -l < "${racine}/${id}/authentik.dump" >/dev/null 2>&1 && [ -s "${racine}/${id}/env" ]; then
    info "Plateforme : sauvegarde des comptes ${id} relue sans erreur."
  else
    echo "❌ Plateforme : la sauvegarde des comptes ${id} est illisible." >&2; return 1
  fi
}

cmd_tester_sauvegarde() {
  [ $# -eq 1 ] || die "Usage : recipelog-instance tester-sauvegarde <nom>|--tous"
  if [ "$1" = "--tous" ]; then
    local d echecs=0
    for d in "${INSTANCES}"/*/; do
      [ -d "${d}" ] || continue
      [ "$(conf_lire "$(basename "${d}")" DEMO)" = 1 ] && continue
      tester_un "$(basename "${d}")" || echecs=$((echecs + 1))
    done
    tester_plateforme || echecs=$((echecs + 1))
    [ "${echecs}" -eq 0 ] || die "${echecs} sauvegarde(s) en échec."
  elif [ "$1" = "_plateforme" ]; then
    tester_plateforme || exit 1
  else
    existe "$1" || die "Client « $1 » inconnu."
    tester_un "$1" || exit 1
  fi
}

# Archive .tar.gz sur la sortie standard : base + fichiers, sans les mots de passe.
cmd_exporter() {
  local nom="${1:-}" id="${2:-}" sauv
  [ -n "${nom}" ] && [ -n "${id}" ] || die "Usage : recipelog-instance exporter <nom> <sauvegarde> > fichier.tar.gz"
  id_valide "${id}"
  sauv="$(dossier_sauv "${nom}")/${id}"
  [ -r "${sauv}/base.dump" ] || die "Sauvegarde « ${id} » introuvable pour ${nom}."
  [ -t 1 ] && die "Rediriger la sortie vers un fichier : … > ${nom}-${id}.tar.gz"
  if [ -d "${sauv}/fichiers" ]; then
    tar -C "${sauv}" -czf - base.dump infos.json fichiers
  else
    tar -C "${sauv}" -czf - base.dump infos.json fichiers.tar.gz
  fi
}

# ------------------------------------------------------------ déménagement (lot 4)
# importer <nom> <archive.tar.gz> --oui : remplace les données d'un client (déjà créé)
# par une archive qui contient base.dump (pg_dump -Fc) et les fichiers : soit un dossier
# fichiers/uploads/ (format de « exporter »), soit fichiers.tar.gz avec uploads/ dedans
# (format de exporter-ancien.sh, pour un ancien site en LXC).
# Une archive sans aucune photo ni facture est refusée (export raté ?), sauf --sans-fichiers.
# convertir_dump_recent <base.dump> : sauvegarde faite par un PostgreSQL plus récent que celui
# de la plateforme (ex. ancien site sous Debian 13 = PostgreSQL 17). Un pg_restore de la même
# version la relit en SQL, chargée dans une base temporaire de la plateforme, puis ressortie
# au format de la plateforme. Rien n'est touché si une étape échoue.
PG_RECENT_IMAGE="${PG_RECENT_IMAGE:-postgres:17-alpine}"
convertir_dump_recent() {
  local f="$1" tmpdb="rl_conversion_$$" ok=1
  info "Base de l'ancien site faite par un PostgreSQL plus récent : conversion (1 à 2 min)…"
  docker run --rm -i --network none "${PG_RECENT_IMAGE}" pg_restore -f - --no-owner --no-acl < "${f}" > "${f}.sql" || return 1
  # Réglage propre à PostgreSQL 17, inconnu des versions d'avant.
  sed -i '/^SET transaction_timeout/d' "${f}.sql"
  docker exec "${PG}" psql -U postgres -qc "DROP DATABASE IF EXISTS ${tmpdb}" >/dev/null 2>&1 && \
  docker exec "${PG}" psql -U postgres -qc "CREATE DATABASE ${tmpdb}" >/dev/null || { rm -f "${f}.sql"; return 1; }
  if docker exec -i "${PG}" psql -U postgres -q -v ON_ERROR_STOP=1 -d "${tmpdb}" < "${f}.sql" >/dev/null \
    && docker exec "${PG}" pg_dump -U postgres -Fc --no-owner --no-acl -d "${tmpdb}" > "${f}.nouveau" \
    && [ -s "${f}.nouveau" ]; then
    mv "${f}.nouveau" "${f}"; ok=0
  fi
  docker exec "${PG}" psql -U postgres -qc "DROP DATABASE IF EXISTS ${tmpdb}" >/dev/null || true
  rm -f "${f}.sql" "${f}.nouveau"
  return "${ok}"
}

cmd_importer() {
  local nom="${1:-}" fichier="${2:-}" ok="" vide=0 racine id tmp nb comptes
  [ -n "${nom}" ] && [ -n "${fichier}" ] || die "Usage : recipelog-instance importer <nom> <archive.tar.gz> --oui [--sans-fichiers]"
  shift 2
  while [ $# -gt 0 ]; do
    case "$1" in
      --oui) ok="--oui"; shift ;;
      --sans-fichiers) vide=1; shift ;;
      *) die "Option inconnue : $1" ;;
    esac
  done
  existe "${nom}" || die "Crée d'abord le client : recipelog-instance creer ${nom} …"
  [ -r "${fichier}" ] || die "Archive ${fichier} introuvable."
  [ "${ok}" = "--oui" ] || die "Ajoute --oui : les données actuelles de ${nom} seront remplacées par l'archive."
  racine="$(dossier_sauv "${nom}")"
  mkdir -p "${racine}"; chmod 700 "${SAUVEGARDES}" "${racine}"
  id="$(nouvel_id "${racine}")"
  tmp="${racine}/${id}.partiel"
  mkdir -m 700 "${tmp}"
  abandon() { rm -rf "${tmp:?}"; die "$1"; }
  tar -C "${tmp}" --no-same-owner --no-same-permissions -xzf "${fichier}" \
    || abandon "Archive illisible ou incomplète (copie coupée ?). Refais l'export et la copie."
  [ -f "${tmp}/base.dump" ] || abandon "Il manque base.dump dans l'archive (voir exporter-ancien.sh)."
  local erreur_pg
  if ! erreur_pg="$(docker exec -i "${PG}" pg_restore -l < "${tmp}/base.dump" 2>&1 >/dev/null)" \
    && [[ "${erreur_pg}" == *"unsupported version"* ]]; then
    convertir_dump_recent "${tmp}/base.dump" || abandon "La base de l'ancien site (PostgreSQL plus récent) n'a pas pu être convertie : rien n'a été importé."
    erreur_pg="$(docker exec -i "${PG}" pg_restore -l < "${tmp}/base.dump" 2>&1 >/dev/null)" || true
  fi
  if ! docker exec -i "${PG}" pg_restore -l < "${tmp}/base.dump" >/dev/null 2>&1; then
    # Le vrai message de PostgreSQL : souvent « unsupported version » (base exportée par un
    # PostgreSQL plus récent que celui de la plateforme) ou un fichier qui n'est pas un pg_dump.
    abandon "base.dump n'a pas pu être lu par PostgreSQL : ${erreur_pg:-raison inconnue} (début du fichier : « $(head -c 5 "${tmp}/base.dump" | tr -dc '[:print:]') », attendu « PGDMP »)."
  fi
  if [ -f "${tmp}/fichiers.tar.gz" ]; then
    mkdir -p "${tmp}/fichiers"
    tar -C "${tmp}/fichiers" --no-same-owner --no-same-permissions -xzf "${tmp}/fichiers.tar.gz" \
      || abandon "fichiers.tar.gz (photos et factures) est abîmé : rien n'a été importé."
    rm -f "${tmp}/fichiers.tar.gz"
  fi
  # Démo figée d'une ancienne installation : uploads/uploads/… → un cran de trop.
  if [ -d "${tmp}/fichiers/uploads/uploads" ] && [ "$(find "${tmp}/fichiers/uploads" -mindepth 1 -maxdepth 1 | wc -l)" = 1 ]; then
    mv "${tmp}/fichiers/uploads/uploads" "${tmp}/fichiers/uploads.bon"
    rmdir "${tmp}/fichiers/uploads"
    mv "${tmp}/fichiers/uploads.bon" "${tmp}/fichiers/uploads"
  fi
  mkdir -p "${tmp}/fichiers/uploads"
  nb="$(find "${tmp}/fichiers/uploads" -type f | wc -l)"
  if [ "${nb}" = 0 ] && [ "${vide}" = 0 ]; then
    abandon "L'archive ne contient AUCUNE photo ni facture : l'export a sans doute raté. Rien n'a été importé. (Si l'ancien site n'avait vraiment aucun fichier : ajoute --sans-fichiers.)"
  fi
  find "${tmp}" -mindepth 1 -maxdepth 1 ! -name base.dump ! -name fichiers -exec rm -rf {} +
  printf '{"id":"%s","date":"%s","etiquette":"importee","version":"","base":%s,"fichiers":%s,"nbFichiers":%s}\n' \
    "${id}" "$(date -u +%Y-%m-%dT%H:%M:%SZ)" "$(stat -c %s "${tmp}/base.dump")" "$(du -sb "${tmp}/fichiers" | cut -f1)" "${nb}" > "${tmp}/infos.json"
  chmod 600 "${tmp}/base.dump" "${tmp}/infos.json"
  mv "${tmp}" "${racine}/${id}"
  info "Archive rangée comme sauvegarde ${id} (« importée ») : ${nb} photo(s) et facture(s)."
  cmd_restaurer "${nom}" "${id}" --oui
  info "Importé : $(docker exec "${PG}" psql -U postgres -d "$(base "${nom}")" -tAc 'SELECT count(*) FROM recipes' 2>/dev/null || echo '?') recette(s), ${nb} photo(s) et facture(s)."
  comptes="$(comptes_actifs "${nom}")"
  if [ -n "${comptes}" ]; then
    echo
    echo "Comptes actifs de l'ancien site (rôles gardés) :"
    # shellcheck disable=SC2086
    printf '  %s\n' ${comptes}
    if [ "$(conf_lire "${nom}" CONNEXION)" = authentik ]; then
      echo "Pour envoyer à chacun l'email « Choisis ton mot de passe » :"
      echo "  recipelog-instance inviter-comptes ${nom}"
    fi
  fi
}

# comptes_actifs <nom> : emails des comptes actifs de l'appli, sans les administrateurs
# cachés (super-admins, déjà partout).
comptes_actifs() {
  local admins
  admins="$(sed -n 's/^RECIPELOG_ADMIN_EMAILS=//p' "${INSTANCES}/$1/instance.env" | tr ',;' '\n\n' | tr -d ' ' | tr '[:upper:]' '[:lower:]' | grep . || true)"
  docker exec "${PG}" psql -U postgres -d "$(base "$1")" -tAc "SELECT lower(email) FROM accounts WHERE status = 'active' ORDER BY 1" 2>/dev/null \
    | { if [ -n "${admins}" ]; then grep -vxF -f <(printf '%s\n' "${admins}"); else cat; fi; } || true
}

# Invite dans Authentik chaque compte actif de l'appli (après un import).
cmd_inviter_comptes() {
  local nom="${1:-}" email n=0 echecs=0
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance inviter-comptes <nom existant>"
  [ "$(conf_lire "${nom}" CONNEXION)" = authentik ] || die "${nom} n'utilise pas Authentik."
  for email in $(comptes_actifs "${nom}"); do
    if passerelle inviter "${nom}" "${email}" >/dev/null 2>&1; then
      info "Invitation envoyée à ${email}."; n=$((n + 1))
    else
      echo "⚠️  ${email} : invitation impossible (déjà dans l'équipe, ou plus de place ?)." >&2; echecs=$((echecs + 1))
    fi
  done
  info "✅ ${n} invitation(s) envoyée(s)$([ "${echecs}" -gt 0 ] && echo ", ${echecs} à revoir")."
}

# ------------------------------------------------------------ démo
# demo-figer <nom> : l'état actuel devient la référence ; demo-remettre la recharge
# (chaque nuit à 4 h 30 par le moteur, ou en 1 clic dans le panel).
demo_ref() { echo "$(dossier_sauv "$1")/reference"; }

cmd_demo_figer() {
  local nom="${1:-}" id ref
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance demo-figer <nom>"
  [ "$(conf_lire "${nom}" DEMO)" = 1 ] || die "${nom} n'est pas une démo (créée avec --demo)."
  id="$(sauvegarder_un "${nom}" reference --sans-rotation)" || die "Sauvegarde ratée."
  ref="$(demo_ref "${nom}")"
  find "$(dossier_sauv "${nom}")" -mindepth 1 -maxdepth 1 -name 'reference' -exec rm -rf {} +
  mv "$(dossier_sauv "${nom}")/${id}" "${ref}"
  info "✅ État actuel de ${nom} gardé comme référence de la démo."
}

cmd_demo_remettre() {
  local nom="${1:-}" ref
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance demo-remettre <nom>|--toutes"
  ref="$(demo_ref "${nom}")"
  [ -r "${ref}/base.dump" ] || die "Pas encore de référence pour ${nom} : recipelog-instance demo-figer ${nom}"
  appliquer "${nom}" "${ref}" || { suspendu "${nom}" || lancer "${nom}"; die "La référence de ${nom} ne se recharge pas : la démo n'a pas été remise à zéro."; }
  if suspendu "${nom}"; then info "${nom} remis à zéro (reste en pause)."; return 0; fi
  lancer "${nom}"
  attendre "${nom}" || die "${nom} ne redémarre pas : recipelog-instance journaux ${nom}"
  info "✅ Démo ${nom} remise à zéro."
}

cmd_demos_remettre() {
  local d n echecs=0
  for d in "${INSTANCES}"/*/; do
    [ -d "${d}" ] || continue
    n="$(basename "${d}")"
    [ "$(conf_lire "${n}" DEMO)" = 1 ] && [ -r "$(demo_ref "${n}")/base.dump" ] || continue
    # Dans un sous-processus : une démo qui rate n'empêche pas les suivantes.
    ( cmd_demo_remettre "${n}" ) || echecs=$((echecs + 1))
  done
  [ "${echecs}" -eq 0 ] || die "${echecs} démo(s) non remise(s) à zéro."
}

# ------------------------------------------------------------ vitrine
# La vitrine (branche site-vitrine, jamais modifiée ici) est servie par les
# conteneurs recipelog-vitrine (nginx) et recipelog-vitrine-contact (formulaire).
#   vitrine maj                  télécharge la dernière version de la branche
#   vitrine bandeau "texte"      bandeau en haut du site ("" pour l'enlever)
#   vitrine demandes [--json]    messages reçus par le formulaire
#   vitrine traitee <clé>        marque une demande comme traitée
VITRINE="${DONNEES}/vitrine"
VITRINE_BRANCHE="${VITRINE_BRANCHE:-site-vitrine}"
VITRINE_DEPOT="${VITRINE_DEPOT:-SuperNon0/recipelogs}"

telecharger() { # telecharger <url> <fichier>
  if command -v curl >/dev/null; then curl -fsSL --retry 2 -o "$2" "$1"; else wget -q -O "$2" "$1"; fi
}

vitrine_reglages() {
  local r="${VITRINE}/reglages" contact demo="" de
  mkdir -p "${r}" "${VITRINE}/messages"
  chown 1000:1000 "${VITRINE}/messages"
  # Adresse montrée aux visiteurs (VITRINE_CONTACT) ; les messages du formulaire arrivent
  # à VITRINE_DESTINATAIRE, sinon à ton adresse d'administrateur.
  contact="${VITRINE_CONTACT:-${ADMIN_EMAILS%%,*}}"
  local destinataire="${VITRINE_DESTINATAIRE:-${ADMIN_EMAILS%%,*}}"
  existe demo && demo="https://demo.${DOMAINE}"
  printf '// Écrit par recipelog-instance vitrine (gardé aux mises à jour).\nwindow.VITRINE = { demoUrl: "%s", contactEmail: "%s" };\n' "${demo}" "${contact}" > "${r}/config.js"
  printf '%s' "${contact}" > "${r}/contact"
  # Formulaire « Nous écrire » : même compte d'envoi que la plateforme (Brevo).
  de="$(printf '%s' "${SMTP_EXPEDITEUR:-}" | sed -n 's/.*<\([^>]*\)>.*/\1/p')"
  umask 077
  printf 'SMTP_HOST=%s\nSMTP_PORT=%s\nSMTP_USER=%s\nSMTP_PASS=%s\nSMTP_FROM=%s\nMAIL_TO=%s\n' \
    "${SMTP_HOTE:-}" "${SMTP_PORT:-587}" "${SMTP_UTILISATEUR:-}" "${SMTP_MOT_DE_PASSE:-}" "${de:-${SMTP_EXPEDITEUR:-}}" "${destinataire:-${contact}}" > "${r}/smtp"
  umask 022
  chown 1000:1000 "${r}/smtp"
  [ -f "${r}/bandeau.js" ] || printf '/* pas de bandeau */\n' > "${r}/bandeau.js"
}

vitrine_maj() {
  local tmp archive racine v
  mkdir -p "${VITRINE}"
  tmp="$(mktemp -d "${VITRINE}/.maj.XXXXXX")"
  archive="${tmp}/code.tar.gz"
  info "Téléchargement de la vitrine (branche ${VITRINE_BRANCHE})…"
  telecharger "https://codeload.github.com/${VITRINE_DEPOT}/tar.gz/refs/heads/${VITRINE_BRANCHE}" "${archive}" \
    || { find "${tmp}" -delete 2>/dev/null; die "Téléchargement de la vitrine impossible."; }
  mkdir -p "${tmp}/code"
  tar -C "${tmp}/code" --strip-components 1 --no-same-owner -xzf "${archive}"
  [ -f "${tmp}/code/site/index.html" ] || { find "${tmp}" -delete; die "La branche ${VITRINE_BRANCHE} n'a pas de site/index.html."; }
  # Version dans les liens du style et du script : les navigateurs reprennent les nouveaux fichiers.
  v="$(cat "${tmp}/code/site/"*.js "${tmp}/code/site/"*.css | sha256sum | cut -c1-8)"
  sed -i -E "s#(href=\"style\.css|src=\"app\.js)(\?v=[0-9a-f]+)?\"#\1?v=${v}\"#g" "${tmp}/code/site/index.html"
  printf '%s\n' "${v}" > "${tmp}/code/.version"
  racine="${VITRINE}/code"
  find "${VITRINE}" -mindepth 1 -maxdepth 1 -name 'code.ancien' -exec rm -rf {} +
  [ -d "${racine}" ] && mv "${racine}" "${VITRINE}/code.ancien"
  mv "${tmp}/code" "${racine}"
  find "${VITRINE}" -mindepth 1 -maxdepth 1 \( -name 'code.ancien' -o -name '.maj.*' \) -exec rm -rf {} +
  vitrine_reglages
  docker restart recipelog-vitrine recipelog-vitrine-contact >/dev/null 2>&1 || true
  info "✅ Vitrine à jour (${v}) : https://${DOMAINE}"
}

vitrine_bandeau() {
  local texte="${1:-}" r="${VITRINE}/reglages" json
  mkdir -p "${r}"
  [ "${#texte}" -le 300 ] || die "Bandeau trop long (300 caractères au plus)."
  if [ -z "${texte}" ]; then
    printf '/* pas de bandeau */\n' > "${r}/bandeau.js"
    : > "${r}/bandeau.txt"
    info "Bandeau retiré."; return 0
  fi
  # Texte passé en JSON (échappé), affiché avec textContent : pas de HTML possible.
  json="$(printf '%s' "${texte}" | sed -e 's/\\/\\\\/g' -e 's/"/\\"/g' -e 's/</\\u003c/g' | tr -d '\r\n')"
  cat > "${r}/bandeau.js" <<JS
// Bandeau du site vitrine (recipelog-instance vitrine bandeau).
(function () {
  var b = document.createElement("div");
  b.textContent = "${json}";
  b.setAttribute("role", "status");
  b.style.cssText = "position:relative;z-index:9999;padding:10px 16px;text-align:center;font:600 14px/1.4 system-ui,sans-serif;background:#1f1b16;color:#f7efe2;";
  document.body.insertBefore(b, document.body.firstChild);
})();
JS
  printf '%s' "${texte}" > "${r}/bandeau.txt"
  info "Bandeau affiché : ${texte}"
}

vitrine_demandes() {
  local f="${VITRINE}/messages/messages.jsonl" t="${VITRINE}/traitees.txt"
  if [ "${1:-}" = "--json" ]; then
    printf '{"demandes":['
    [ -s "${f}" ] && tail -n 200 "${f}" | paste -sd, -
    printf '],"traitees":['
    [ -s "${t}" ] && sed 's/.*/"&"/' "${t}" | paste -sd, -
    printf ']}\n'
    return
  fi
  [ -s "${f}" ] || { echo "Aucune demande reçue pour l'instant."; return 0; }
  tail -n 20 "${f}"
}

vitrine_traitee() {
  local cle="${1:-}"
  [[ "${cle}" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}\ [0-9]{2}:[0-9]{2}:[0-9]{2}\|[^[:space:]\"]+@[^[:space:]\"]+$ ]] || die "Clé de demande invalide."
  grep -qxF "${cle}" "${VITRINE}/traitees.txt" 2>/dev/null || printf '%s\n' "${cle}" >> "${VITRINE}/traitees.txt"
  info "Demande marquée comme traitée."
}

cmd_vitrine() {
  local sous="${1:-}"; shift || true
  case "${sous}" in
    maj) vitrine_maj ;;
    reglages) vitrine_reglages; info "Réglages de la vitrine réécrits." ;;
    bandeau) vitrine_bandeau "${1:-}" ;;
    demandes) vitrine_demandes "${1:-}" ;;
    traitee) vitrine_traitee "${1:-}" ;;
    *) die "Usage : recipelog-instance vitrine maj | reglages | bandeau \"texte\" | demandes [--json] | traitee <clé>" ;;
  esac
}

# Supprime un client en gardant une archive (base + fichiers) dans archives/.
cmd_supprimer() {
  local nom="${1:-}" ok="${2:-}"
  [ -n "${nom}" ] && existe "${nom}" || die "Usage : recipelog-instance supprimer <nom existant> --oui"
  [ "${ok}" = "--oui" ] || die "Ajoute --oui pour confirmer la suppression de « ${nom} »."
  local db arch
  db="$(base "${nom}")"
  arch="${ARCHIVES}/${nom}-$(date +%Y%m%d-%H%M%S)"
  mkdir -p "${arch}"
  info "Archive de la base et des fichiers dans ${arch}…"
  docker exec "${PG}" pg_dump -U postgres -Fc "${db}" > "${arch}/base.dump" || { rm -rf "${arch:?}"; die "La base n'a pas pu être archivée : ${nom} n'est PAS supprimé."; }
  tar -C "${INSTANCES}/${nom}" -czf "${arch}/fichiers.tar.gz" . || { rm -rf "${arch:?}"; die "Les fichiers n'ont pas pu être archivés : ${nom} n'est PAS supprimé."; }
  chmod -R go-rwx "${arch}"
  docker rm -f "$(conteneur "${nom}")" >/dev/null 2>&1 || true
  psql_admin <<SQL
DROP DATABASE IF EXISTS ${db} WITH (FORCE);
DROP ROLE IF EXISTS ${db};
SQL
  if grep -q '^CONNEXION=authentik' "${INSTANCES}/${nom}/instance.conf"; then
    info "Retrait du client dans Authentik (les comptes qui ne servent plus sont désactivés)…"
    passerelle client-supprimer "${nom}" >/dev/null || echo "⚠️  Authentik : client « ${nom} » non retiré. À refaire : docker exec recipelog-passerelle node cli.mjs client-supprimer ${nom}" >&2
  fi
  if [ -d "$(dossier_sauv "${nom}")" ]; then mv "$(dossier_sauv "${nom}")" "${arch}/sauvegardes"; fi
  # Demandes de support et compteurs IA : un futur client du même nom n'en hérite pas.
  if [ -d "${DONNEES}/support/${nom}" ]; then mv "${DONNEES}/support/${nom}" "${arch}/support"; fi
  if [ -f "${DONNEES}/ia/usage/${nom}.json" ]; then mv "${DONNEES}/ia/usage/${nom}.json" "${arch}/ia-usage.json"; fi
  rm -rf "${INSTANCES:?}/${nom}"
  info "✅ ${nom} supprimé. Archive (avec ses sauvegardes) : ${arch}$([ "${ARCHIVES_JOURS}" -gt 0 ] && echo ", effacée dans ${ARCHIVES_JOURS} jours")"
}

[ "$(id -u)" -eq 0 ] || die "À lancer en root."
mkdir -p "${INSTANCES}" "${ARCHIVES}" "${SAUVEGARDES}"
action="${1:-}"; shift || true

# Une seule commande qui modifie à la fois, que ce soit le panel, la nuit ou toi à la main.
# Les commandes qui ne font que lire passent sans attendre.
case "${action}" in
  liste|equipe|journaux|sauvegardes|exporter|"") ;;
  vitrine) case "${1:-}" in demandes|"") ;; *) VERROU=1 ;; esac ;;
  *) VERROU=1 ;;
esac
if [ "${VERROU:-0}" = 1 ] && command -v flock >/dev/null 2>&1; then
  exec 9>>"${DONNEES}/.verrou"
  if ! flock -n 9; then
    echo "⏳ Une autre action est en cours ($(cat "${DONNEES}/.verrou.quoi" 2>/dev/null || echo "?")) : j'attends qu'elle finisse…" >&2
    flock -w "${VERROU_ATTENTE:-14400}" 9 || die "L'autre action n'a pas fini après 4 heures : abandon."
  fi
  echo "${action} ${1:-} depuis $(date '+%H:%M')" > "${DONNEES}/.verrou.quoi" 2>/dev/null || true
fi

case "${action}" in
  creer) cmd_creer "$@" ;;
  liste) cmd_liste "$@" ;;
  suspendre) cmd_suspendre "$@" ;;
  reactiver) cmd_reactiver "$@" ;;
  options) cmd_options "$@" ;;
  essai) cmd_essai "$@" ;;
  verifier-essais) cmd_verifier_essais ;;
  equipe) cmd_equipe "$@" ;;
  inviter) cmd_inviter "$@" ;;
  quota) cmd_quota "$@" ;;
  brancher-authentik) cmd_brancher "$@" ;;
  mettre-a-jour) cmd_maj "$@" ;;
  canal) cmd_canal "$@" ;;
  redemarrer) cmd_redemarrer "$@" ;;
  journaux) cmd_journaux "$@" ;;
  supprimer) cmd_supprimer "$@" ;;
  sauvegarder) cmd_sauvegarder "$@" ;;
  sauvegarder-plateforme) cmd_sauvegarder_plateforme ;;
  menage) cmd_menage ;;
  sauvegardes) cmd_sauvegardes "$@" ;;
  restaurer) cmd_restaurer "$@" ;;
  tester-sauvegarde) cmd_tester_sauvegarde "$@" ;;
  exporter) cmd_exporter "$@" ;;
  importer) cmd_importer "$@" ;;
  inviter-comptes) cmd_inviter_comptes "$@" ;;
  demo-figer) cmd_demo_figer "$@" ;;
  demo-remettre) if [ "${1:-}" = "--toutes" ]; then cmd_demos_remettre; else cmd_demo_remettre "$@"; fi ;;
  vitrine) cmd_vitrine "$@" ;;
  *) sed -n '2,45p' "$0" | sed 's/^# \{0,1\}//'; exit 1 ;;
esac
