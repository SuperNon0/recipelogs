# PostgreSQL
DATABASE_URL="postgresql://recipelog:recipelog@localhost:5432/recipelog?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Upload paths (à adapter en prod LXC : /var/lib/recipelog/uploads)
UPLOAD_DIR="./public/uploads"
UPLOAD_MAX_BYTES="10485760"

# Auth
SESSION_SECRET=change-me-32-chars-min-random-string-here
SUPERADMIN_EMAIL=noe.fougeray30@gmail.com
SUPERADMIN_PASSWORD=change-me-at-first-launch
# Réécrire le hash du mot de passe admin au prochain seed (défaut : false).
# SEED_FORCE_ADMIN_PASSWORD=false

# Cloudflare Access
CF_TEAM_DOMAIN=super-nono.cloudflareaccess.com
CF_AUD=your-application-audience-id
CF_VERIFY_JWT=true
ALLOW_LOCAL_LOGIN=true

# Permissions (off | member | super_admin)
CAP_ACCOUNT_MANAGEMENT=super_admin
CAP_ADMIN_PASSWORD=super_admin
CAP_SITE_UPDATE=super_admin
