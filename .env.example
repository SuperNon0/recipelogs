# PostgreSQL
# Choisir un mot de passe et reporter la même valeur dans DATABASE_URL.
POSTGRES_PASSWORD=""
DATABASE_URL="postgresql://recipelog:VOTRE_MOT_DE_PASSE@localhost:5432/recipelog?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Dossier des photos. En prod : /var/lib/recipelog/uploads (fixé par deploy.sh / setup.sh)
UPLOAD_DIR="./data/uploads"
UPLOAD_MAX_BYTES="10485760"

# Comptes (Réglages → Comptes). Secours : 1 coupe les comptes sans rien effacer
# (tout le monde retrouve tous les droits), si Cloudflare ne laisse plus entrer personne.
# RECIPELOG_AUTH_OFF=1
