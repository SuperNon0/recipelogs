# PostgreSQL
DATABASE_URL="postgresql://recipelog:recipelog@localhost:5432/recipelog?schema=public"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Dossier des photos. En prod : /var/lib/recipelog/uploads (fixé par deploy.sh / setup.sh)
UPLOAD_DIR="./public/uploads"
UPLOAD_MAX_BYTES="10485760"
